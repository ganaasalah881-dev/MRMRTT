<Window x:Class="DatesErp.Desktop.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="نظام التصنيع" Height="340" Width="600"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent"
        FlowDirection="RightToLeft">
    <Border CornerRadius="14" BorderBrush="#C9A227" BorderThickness="1.5">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#12295E" Offset="0"/>
                <GradientStop Color="#0A246A" Offset="0.5"/>
                <GradientStop Color="#0B3D1F" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <StackPanel VerticalAlignment="Center" Margin="40">
            <Border Width="84" Height="84" CornerRadius="18" Background="#C9A227" BorderBrush="#FFFFFF" BorderThickness="2"
                    HorizontalAlignment="Center">
                <TextBlock Text="🌴" FontSize="42" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="نظام التصنيع" Foreground="White" FontSize="32" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,10,0,0"/>
            <TextBlock Text="النظام المتكامل لإدارة عمليات التصنيع — شبكة الشركة" Foreground="#C9A227"
                       FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,6,0,20"/>
            <TextBlock x:Name="StatusText" Text="جارٍ التحقق من الإعدادات..." Foreground="#DCE8E2"
                       FontSize="13" HorizontalAlignment="Center"/>
            <ProgressBar x:Name="Progress" Height="6" IsIndeterminate="True" Margin="0,16,0,0"
                         Foreground="#C9A227" Background="#16295E" BorderThickness="0"/>
        </StackPanel>
    </Border>
</Window>
