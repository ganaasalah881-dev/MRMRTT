<Window x:Class="DatesErp.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="نظام التصنيع — النظام المتكامل لإدارة عمليات التصنيع"
        Height="800" Width="1360"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        FlowDirection="RightToLeft" Background="{DynamicResource ThemeBackgroundBrush}">
    <DockPanel>
        <!-- ═══ الشريط العلوي الكحلي (المعتمد #0F172A) ═══ -->
        <Border DockPanel.Dock="Top" Height="56" Background="{DynamicResource ThemeTitleBarBrush}">
            <DockPanel Margin="20,0">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Border Width="32" Height="32" CornerRadius="16" Background="#C9A227">
                        <TextBlock Text="🌴" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="الشركة اليمنية لتعبئة وتصنيع التمور — نظام الإدارة المتكامل"
                                   Foreground="#F8FAFC" FontSize="15" FontWeight="Bold"/>
                        <TextBlock Text="DatePack ERP Enterprise" Foreground="#94A3B8" FontSize="11"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock x:Name="TopClock" Foreground="#FDE047" FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center"/>
                    <TextBlock Text="|" Foreground="#475569" Margin="14,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TopUserName" Text="👤 —" Foreground="#F8FAFC" FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center"/>
                    <Border CornerRadius="6" BorderBrush="#1D4ED8" BorderThickness="1" Background="#331D4ED8" Padding="10,3" Margin="14,0,0,0"
                            Cursor="Hand" MouseLeftButtonUp="MyPassword_Click"
                            ToolTip="تغيير كلمة مرورك بنفسك — لا يحتاج أي صلاحية">
                        <TextBlock Text="🔑 كلمتي" Foreground="#93C5FD" FontWeight="Bold" FontSize="12"/>
                    </Border>
                    <Border CornerRadius="6" BorderBrush="#991B1B" BorderThickness="1" Background="#33991B1B" Padding="10,3" Margin="8,0,0,0"
                            Cursor="Hand" MouseLeftButtonUp="Logout_Click">
                        <TextBlock Text="خروج" Foreground="#FCA5A5" FontWeight="Bold" FontSize="12"/>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══ شريط الحالة السفلي (المعتمد #064E3B) ═══ -->
        <Border DockPanel.Dock="Bottom" Height="34" Background="#064E3B" BorderBrush="#047857" BorderThickness="0,1,0,0">
            <DockPanel Margin="20,0">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <TextBlock x:Name="StatusVer" Style="{StaticResource StatusText}">الإصدار: <Bold>1.0.0</Bold></TextBlock>
                    <TextBlock Style="{StaticResource StatusText}" Text="•"/>
                    <TextBlock x:Name="StatusDb" Style="{StaticResource StatusText}">قاعدة البيانات: <Bold Foreground="#A7F3D0">متصلة 🟢</Bold></TextBlock>
                    <TextBlock Style="{StaticResource StatusText}" Text="•"/>
                    <TextBlock x:Name="StatusUser" Style="{StaticResource StatusText}">المستخدم: <Bold>—</Bold></TextBlock>
                    <TextBlock Style="{StaticResource StatusText}" Text="•"/>
                    <TextBlock x:Name="StatusFy" Style="{StaticResource StatusText}">السنة التشغيلية: <Bold>2026</Bold></TextBlock>
                </StackPanel>
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource StatusText}"
                           Text="الشركة اليمنية لتعبئة وتصنيع التمور (Date ERP)"/>
            </DockPanel>
        </Border>

        <!-- §B89: ملء الشاشة — عند دخول أي وحدة تُخفى القائمة الجانبية (SetNavVisible) ويتمدد المحتوى -->
        <Grid x:Name="MainGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavColumn" Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═══ القائمة الجانبية (المعتمدة #1E293B) ═══ -->
            <Border x:Name="SideBar" Grid.Column="0" Background="{DynamicResource ThemeTitleBarBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="10,12">
                    <StackPanel DockPanel.Dock="Top">
                        <Border CornerRadius="8" Background="#0FFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" Padding="14,10" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📊" FontSize="15" VerticalAlignment="Center"/>
                                <TextBlock Text="لوحة المعلومات" Foreground="#F8FAFC" FontWeight="Bold" FontSize="14" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="مركز التحكم الإداري" Foreground="#EAB308" FontWeight="Bold" FontSize="11" Margin="10,0,0,10"/>
                        <StackPanel x:Name="DeptNavPanel"/>
                        <Border BorderBrush="#334155" BorderThickness="0,1,0,0" Margin="0,12,0,10"/>
                        <StackPanel x:Name="SubNavPanel"/>
                    </StackPanel>
                    <Border DockPanel.Dock="Bottom" CornerRadius="8" BorderBrush="#DC2626" BorderThickness="1" Background="#26DC2626"
                            Padding="14,8" Cursor="Hand" MouseLeftButtonUp="Logout_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="🚪" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text="خروج من النظام" Foreground="#FCA5A5" FontWeight="Bold" FontSize="13" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Border>
                </DockPanel>
            </Border>

            <!-- ═══ المحتوى ═══ -->
            <DockPanel Grid.Column="1" Background="{DynamicResource ThemeBackgroundBrush}">
                <!-- شريط المسار -->
                <Border DockPanel.Dock="Top" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="24,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🏠" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock x:Name="CrumbHome" Text=" الرئيسية" Foreground="#334155" FontWeight="SemiBold" FontSize="12.5"
                                   Cursor="Hand" MouseLeftButtonUp="CrumbHome_Click" VerticalAlignment="Center"/>
                        <TextBlock Text=" &gt; " Foreground="#64748B" FontSize="12.5" VerticalAlignment="Center"/>
                        <TextBlock x:Name="CrumbCurrent" Text="لوحة المعلومات" Foreground="#64748B" FontSize="12.5" VerticalAlignment="Center"/>
                        <!-- §B89: زر العودة للوحة — يظهر فقط في وضع ملء الشاشة (القائمة مخفية) -->
                        <!-- §B110: سهم الرجوع يميناً (عرف RTL) موحداً مع زر معرض التقارير -->
                        <Button x:Name="BackToDashBtn" Content="→ عودة إلى لوحة المعلومات" Style="{StaticResource ErpButton}"
                                Click="BackToDash_Click" Visibility="Collapsed" Margin="18,0,0,0"/>
                    </StackPanel>
                </Border>
                <ContentControl x:Name="ContentArea" Margin="14"/>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
