<Window x:Class="DatesErp.Desktop.Views.ConnectionSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إعداد اتصال النظام — Date ERP" Height="700" Width="640"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        FlowDirection="RightToLeft" Background="#F4F6F5">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="إعداد اتصال النظام" Style="{StaticResource SectionTitle}"/>
            <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#4B5A53"
                       Text="أول تشغيل على هذا الجهاز: حدد خادم SQL Server المركزي وقاعدة البيانات. لن تظهر هذه الشاشة مجدداً بعد نجاح الإعداد."/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,14,0,0">
            <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="اسم الخادم" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="ServerBox" Grid.Row="0" Grid.Column="1" Margin="0,4"
                         TextChanged="ConnectionInputChanged" ToolTip="مثال: SERVER01 أو SERVER01\SQLEXPRESS أو 192.168.1.10"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="اسم قاعدة البيانات" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="DatabaseBox" Grid.Row="1" Grid.Column="1" Margin="0,4" Text="MfgSystemDB" TextChanged="ConnectionInputChanged"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="طريقة المصادقة" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="AuthModeBox" Grid.Row="2" Grid.Column="1" Margin="0,4" SelectedIndex="0"
                          SelectionChanged="AuthModeChanged">
                    <ComboBoxItem Content="Windows Authentication (موصى به)"/>
                    <ComboBoxItem Content="SQL Server Authentication"/>
                </ComboBox>

                <!-- §تلميح الوضع المحلي: يظهر فقط إن كان الإعداد الحالي محلياً -->
                <TextBlock x:Name="LocalModeHint" Grid.Row="3" Grid.Column="1" Visibility="Collapsed"
                           TextWrapping="Wrap" FontSize="12" Foreground="#B45309" Margin="0,6,0,0"
                           Text="⚠ النظام يعمل الآن في الوضع المحلي (SQLite). اختر Windows أو SQL Server أعلاه ثم «اختبار الاتصال» ثم «حفظ الإعداد» للتحول إلى الخادم المركزي."/>

                <!-- §حقول SQL تُلفّ في panel واحد فتُظهر/تُخفى معاً بأمان -->
                <StackPanel x:Name="SqlFieldsPanel" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Grid.RowSpan="2" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="UidLabel" Grid.Row="0" Grid.Column="0" Text="اسم مستخدم SQL" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="UidBox" Grid.Row="0" Grid.Column="1" Margin="0,4" TextChanged="ConnectionInputChanged"/>
                        <TextBlock x:Name="PwdLabel" Grid.Row="1" Grid.Column="0" Text="كلمة مرور SQL" Style="{StaticResource FieldLabel}"/>
                        <PasswordBox x:Name="PwdBox" Grid.Row="1" Grid.Column="1" Margin="0,4" PasswordChanged="ConnectionInputChanged"/>
                    </Grid>
                </StackPanel>
            </Grid>
            <CheckBox x:Name="TrustCertificateBox" Margin="0,10,0,0"
                      Content="السماح بشهادة تطوير غير موثوقة (غير موصى به للإنتاج)"
                      Checked="ConnectionInputChanged" Unchecked="ConnectionInputChanged"/>
            <TextBlock Text="الاتصال مشفّر دائماً. في الإنتاج استخدم شهادة موثوقة تطابق اسم الخادم."
                       TextWrapping="Wrap" Foreground="#92400E" FontSize="11" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,14,0,0">
            <Button x:Name="TestBtn" Content="اختبار الاتصال" Style="{StaticResource PrimaryButton}" Click="TestConnection_Click" IsDefault="True"/>
            <Button x:Name="SaveBtn" Content="💾 حفظ الإعداد" Style="{StaticResource PrimaryButton}" Click="Save_Click" IsEnabled="False"/>
        </StackPanel>

        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock Text="نتائج الفحص" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" Foreground="#1B4D3E"/>
                <TextBlock x:Name="ChkServer" Text="الخادم (الخادم المركزي):  —" FontSize="13" Margin="0,3"/>
                <TextBlock x:Name="ChkSql" Text="خدمة SQL Server:  —" FontSize="13" Margin="0,3"/>
                <TextBlock x:Name="ChkDb" Text="قاعدة البيانات:  —" FontSize="13" Margin="0,3"/>
                <TextBlock x:Name="ChkLogin" Text="بيانات الدخول:  —" FontSize="13" Margin="0,3"/>
                <TextBlock x:Name="ChkConn" Text="الاتصال الكامل:  —" FontSize="13" Margin="0,3"/>
                <TextBlock x:Name="ResultMsg" Text="" TextWrapping="Wrap" FontSize="13" Margin="0,10,0,0" Foreground="#4B5A53"/>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="4" Margin="0,10,0,0" FontSize="12" Foreground="#7A8A82" TextWrapping="Wrap"
                   Text="ملاحظة: تأكد من فتح المنفذ TCP 1433 في جدار حماية الخادم، ومن تشغيل SQL Browser للـ Named Instances."/>
    </Grid>
</Window>
