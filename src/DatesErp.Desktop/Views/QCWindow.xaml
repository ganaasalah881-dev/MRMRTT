<Window x:Class="DatesErp.Desktop.Views.QCWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="محضر فحص الجودة" Width="1050" Height="680"
        FlowDirection="RightToLeft" WindowStartupLocation="CenterOwner">
    <DockPanel Background="#F1F5F9">
        <!-- شريط العنوان -->
        <Border DockPanel.Dock="Top" Padding="12,6">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#0A246A" Offset="0"/>
                    <GradientStop Color="#3A6EA5" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel>
                <TextBlock x:Name="HeadTitle" DockPanel.Dock="Right" Foreground="White" FontWeight="Bold" FontSize="13"/>
                <TextBlock x:Name="HeadState" DockPanel.Dock="Left" Foreground="White" FontSize="12" FontWeight="Bold"/>
            </DockPanel>
        </Border>

        <!-- لافتات: تبريد / حجز / معتمد -->
        <Border x:Name="CoolingBanner" DockPanel.Dock="Top" Background="#FFFBEB" BorderBrush="#FCD34D" BorderThickness="0,0,0,1" Padding="12,6">
            <TextBlock x:Name="CoolingText" Foreground="#92400E" FontWeight="Bold" FontSize="12" TextWrapping="Wrap"/>
        </Border>
        <Border x:Name="QuarantineBanner" DockPanel.Dock="Top" Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="0,0,0,1" Padding="12,6">
            <TextBlock x:Name="QuarantineText" Foreground="#991B1B" FontWeight="Bold" FontSize="12" TextWrapping="Wrap"/>
        </Border>

        <!-- شريط الإجراء -->
        <Border DockPanel.Dock="Bottom" Background="#F8FAFC" BorderBrush="#94A3B8" BorderThickness="0,1,0,0" Padding="10,8">
            <StackPanel Orientation="Horizontal">
                <!-- §B110: كانا معكوسين (الحفظ أخضر والاعتماد كحلي) — الحفظ إجراء رئيسي كحلي والاعتماد أخضر -->
                <Button x:Name="BtnSave" Content="💾 حفظ نتائج الفحص" Style="{StaticResource ErpPrimaryButton}" Margin="0,0,8,0" Click="Save_Click"/>
                <Button x:Name="BtnApprove" Content="✅ اعتماد المحضر" Style="{StaticResource ErpApproveButton}" Margin="0,0,8,0" Click="Approve_Click"/>
                <Button x:Name="BtnCorrect" Content="🛠 تصحيح معتمد (بسبب)" Style="{StaticResource ErpButton}" Margin="0,0,8,0" Click="Correct_Click"/>
                <Button Content="✖ إغلاق" Style="{StaticResource ErpButton}" Click="Close_Click"/>
            </StackPanel>
        </Border>

        <TabControl Margin="8" Background="White">
            <TabItem Header="🔬 نتائج الفحص">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                        <Border Background="#F8FAFC" BorderBrush="#94A3B8" BorderThickness="1" Padding="10,6" Margin="0,0,8,4">
                            <StackPanel>
                                <TextBlock Text="أمر التشغيل" FontSize="10.5" Foreground="#555"/>
                                <TextBlock x:Name="FOrder" FontSize="13" FontWeight="Bold" Foreground="#0A246A"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#F8FAFC" BorderBrush="#94A3B8" BorderThickness="1" Padding="10,6" Margin="0,0,8,4">
                            <StackPanel>
                                <TextBlock Text="العميل / الدفعة" FontSize="10.5" Foreground="#555"/>
                                <TextBlock x:Name="FCustomer" FontSize="13" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#F8FAFC" BorderBrush="#94A3B8" BorderThickness="1" Padding="10,6" Margin="0,0,8,4">
                            <StackPanel>
                                <TextBlock Text="تاريخ الفحص / المتوقع" FontSize="10.5" Foreground="#555"/>
                                <TextBlock x:Name="FDate" FontSize="13" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1" Padding="10,6" Margin="0,0,8,4">
                            <StackPanel>
                                <TextBlock Text="المُقبل" FontSize="10.5" Foreground="#166534"/>
                                <TextBlock x:Name="FAccepted" FontSize="13" FontWeight="Bold" Foreground="#166534"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" Padding="10,6" Margin="0,0,8,4">
                            <StackPanel>
                                <TextBlock Text="المرفوض" FontSize="10.5" Foreground="#991B1B"/>
                                <TextBlock x:Name="FRejected" FontSize="13" FontWeight="Bold" Foreground="#991B1B"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#F8FAFC" BorderBrush="#94A3B8" BorderThickness="1" Padding="10,6">
                            <StackPanel>
                                <TextBlock Text="قرار الجودة" FontSize="10.5" Foreground="#555"/>
                                <TextBlock x:Name="FDecision" FontSize="13" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DataGrid x:Name="ResultsGrid" Grid.Row="0" IsReadOnly="True" FontSize="11.5" AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="الصنف" Binding="{Binding ProductName}" Width="*"/>
                                <DataGridTextColumn Header="الدفعة" Binding="{Binding LotCode}" Width="90"/>
                                <DataGridTextColumn Header="المفحوص (كجم)" Binding="{Binding CheckedKg}" Width="100"/>
                                <DataGridTextColumn Header="المقبول (كجم)" Binding="{Binding AcceptedKg}" Width="100"/>
                                <DataGridTextColumn Header="المرفوض (كجم)" Binding="{Binding RejectedKg}" Width="100"/>
                                <DataGridTextColumn Header="المفحوص (كرتون)" Binding="{Binding CheckedCtn}" Width="110"/>
                                <DataGridTextColumn Header="المقبول (كرتون)" Binding="{Binding AcceptedCtn}" Width="110"/>
                                <DataGridTextColumn Header="المرفوض (كرتون)" Binding="{Binding RejectedCtn}" Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <!-- قيم المعمل (إن دخلت) -->
                        <Border x:Name="LabPanel" Grid.Row="1" Margin="0,8,0,0" Background="#F8FAFC" BorderBrush="#94A3B8" BorderThickness="1" Padding="10,6">
                            <WrapPanel>
                                <TextBlock Text="🔬 المعمل:" FontWeight="Bold" FontSize="11.5" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="FLab" FontSize="11.5" VerticalAlignment="Center"/>
                            </WrapPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="✍️ إدخال النتائج">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="InputGrid" Grid.Row="0" FontSize="11.5" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الصنف" Binding="{Binding ProductName}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="الدفعة" Binding="{Binding LotCode}" Width="90" IsReadOnly="True"/>
                            <DataGridTextColumn Header="العبوة" Binding="{Binding PackageName}" Width="105" IsReadOnly="True"/>
                            <DataGridTextColumn Header="المتبقي للفحص (كرتون)" Binding="{Binding RemainingCtn}" Width="130" IsReadOnly="True"/>
                            <DataGridTextColumn Header="المقبول (كرتون) ✍️" Binding="{Binding AcceptedCtn, UpdateSourceTrigger=PropertyChanged}" Width="130"/>
                            <DataGridTextColumn Header="المرفوض (كرتون) ✍️" Binding="{Binding RejectedCtn, UpdateSourceTrigger=PropertyChanged}" Width="130"/>
                            <DataGridTextColumn Header="المقبول (كجم)" Binding="{Binding AcceptedKg}" Width="100" IsReadOnly="True"/>
                            <DataGridTextColumn Header="المرفوض (كجم)" Binding="{Binding RejectedKg}" Width="100" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel x:Name="DecisionPanel" Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="قرار الجودة:" FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox x:Name="CmbDecision" Width="180" FontSize="12" SelectionChanged="Decision_Changed">
                            <ComboBoxItem Content="✅ مطابق — مقبول للإفراج (Passed)" Tag="Passed" IsSelected="True"/>
                            <ComboBoxItem Content="🚫 حجز وتحريز مؤقت (Quarantine)" Tag="Quarantine"/>
                            <ComboBoxItem Content="🗑 مرفوض / عوادم (Rejected)" Tag="Rejected"/>
                        </ComboBox>
                    </StackPanel>

                    <Border Grid.Row="2" Margin="0,10,0,0" Background="#F8FAFC" BorderBrush="#94A3B8" BorderThickness="1" Padding="10,6">
                        <WrapPanel>
                            <TextBlock Text="🔬 معايير المخبر (اختياري):" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="الرطوبة %:" FontSize="11.5" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtMoisture" Width="60" FontSize="11.5" Margin="0,0,12,0"/>
                            <TextBlock Text="Brix°:" FontSize="11.5" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtBrix" Width="60" FontSize="11.5" Margin="0,0,12,0"/>
                            <TextBlock Text="انفصال القشرة %:" FontSize="11.5" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtSkin" Width="60" FontSize="11.5" Margin="0,0,12,0"/>
                            <TextBlock Text="الشوائب %:" FontSize="11.5" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtImpurities" Width="60" FontSize="11.5" Margin="0,0,12,0"/>
                            <TextBlock Text="العينة (كرتون):" FontSize="11.5" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtSample" Width="50" FontSize="11.5" Margin="0,0,12,0"/>
                            <TextBlock Text="ملاحظات الفاحص:" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="TxtNotes" Width="220" FontSize="11.5"/>
                        </WrapPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="📜 التاريخ والتصحيحات">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="CorrectionsGrid" Grid.Row="0" IsReadOnly="True" FontSize="11.5" AutoGenerateColumns="False" Margin="0,0,0,8" MaxHeight="150">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="تصحيح معتمد: التاريخ" Binding="{Binding Date}" Width="140"/>
                            <DataGridTextColumn Header="بواسطة" Binding="{Binding User}" Width="140"/>
                            <DataGridTextColumn Header="السبب" Binding="{Binding Reason}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <DataGrid x:Name="HistoryGrid" Grid.Row="1" IsReadOnly="True" FontSize="11.5" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الوقت" Binding="{Binding Time}" Width="140"/>
                            <DataGridTextColumn Header="المستخدم" Binding="{Binding User}" Width="140"/>
                            <DataGridTextColumn Header="الإجراء" Binding="{Binding Action}" Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
