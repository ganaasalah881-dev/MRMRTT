<Window x:Class="DatesErp.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تسجيل الدخول — نظام التصنيع" Height="560" Width="880"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        FlowDirection="RightToLeft">
    <Window.Background>
        <RadialGradientBrush GradientOrigin="0.5,0.4" Center="0.5,0.5" RadiusX="0.9" RadiusY="0.9">
            <GradientStop Color="#2C5282" Offset="0"/>
            <GradientStop Color="#1A365D" Offset="0.55"/>
            <GradientStop Color="#0F172A" Offset="1"/>
        </RadialGradientBrush>
    </Window.Background>

    <Grid>
        <!-- ═══ نافذة ERP الكلاسيكية (مطابقة للنظام المرجعي) ═══ -->
        <Border Width="790" Background="#F4F3EA" BorderBrush="#5C768D" BorderThickness="2" CornerRadius="4">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="0" BlurRadius="36" Opacity="0.55" Color="Black"/>
            </Border.Effect>
            <DockPanel>
                <!-- شريط العنوان -->
                <Border DockPanel.Dock="Top" Padding="10,5">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#A8C2D8" Offset="0"/>
                            <GradientStop Color="#7E9EB8" Offset="0.45"/>
                            <GradientStop Color="#5E82A0" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <Border Width="18" Height="16" Background="#F1F5F9" BorderBrush="#94A3B8" BorderThickness="1" CornerRadius="2" Margin="2,0" Cursor="Hand" MouseLeftButtonDown="FakeMin_Click" ToolTip="تصغير">
                                <TextBlock Text="—" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border Width="18" Height="16" Background="#F1F5F9" BorderBrush="#94A3B8" BorderThickness="1" CornerRadius="2" Margin="2,0" Cursor="Hand" MouseLeftButtonDown="FakeMax_Click" ToolTip="تكبير/استعادة">
                                <TextBlock Text="□" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border Width="18" Height="16" Background="#F1F5F9" BorderBrush="#94A3B8" BorderThickness="1" CornerRadius="2" Margin="2,0" Cursor="Hand" MouseLeftButtonDown="FakeClose_Click" ToolTip="إغلاق">
                                <TextBlock Text="✕" FontSize="9" Foreground="#B91C1C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌴" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="TitleBarText" Text="نظام التصنيع — تسجيل الدخول" Foreground="White" FontWeight="Bold" FontSize="12.5">
                                <TextBlock.Effect>
                                    <DropShadowEffect ShadowDepth="1" BlurRadius="2" Opacity="0.6"/>
                                </TextBlock.Effect>
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- جسم النافذة: الهوية + نموذج الدخول -->
                <Grid>
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FBFBF7" Offset="0"/>
                            <GradientStop Color="#F5F4EC" Offset="0.6"/>
                            <GradientStop Color="#F1F5F9" Offset="1"/>
                        </LinearGradientBrush>
                    </Grid.Background>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>

                    <!-- ═══ لوحة الهوية (العلامة التجارية) ═══ -->
                    <Border Grid.Column="0" BorderBrush="#CBD5E1" BorderThickness="0,0,1,0" Padding="28,24">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <!-- الشعار: المرفوع من الإعدادات أو الافتراضي الذهبي -->
                            <Grid HorizontalAlignment="Center" Margin="0,0,0,16">
                                <Image x:Name="LogoImage" Width="92" Height="92" Stretch="Uniform" Visibility="Collapsed"/>
                                <Border x:Name="DefaultLogo" Width="86" Height="86" CornerRadius="18" Background="#C9A227" BorderBrush="#0B3D1F" BorderThickness="2.5">
                                    <TextBlock Text="🌴" FontSize="42" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                            <TextBlock x:Name="CompanyNameText" Text="نظام التصنيع" FontSize="22" FontWeight="Bold"
                                       Foreground="#0B3D1F" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                            <TextBlock Text="النظام المتكامل لإدارة عمليات التصنيع" FontSize="14" Foreground="#C9A227"
                                       FontWeight="Bold" HorizontalAlignment="Center" Margin="0,6,0,14"/>
                            <Border Height="2" Width="220" Background="#C9A227" Opacity="0.65" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="CompanyMetaText" Text="" FontSize="11.5" Foreground="#5F6368"
                                       HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- ═══ نموذج الدخول ═══ -->
                    <Border Grid.Column="1" Background="#F7F6EE" Padding="24,28">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="تسجيل الدخول" FontSize="16" FontWeight="Bold" Foreground="#0A246A" Margin="0,0,0,4"/>
                            <TextBlock Text="الدخول بالرقم — كل موظف يأخذ رقماً للدخول من شاشة الموظفين" FontSize="11" Foreground="#6B7280" Margin="0,0,0,16" TextWrapping="Wrap"/>

                            <TextBlock Text="رقم الدخول (أو اسم المستخدم)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="UserNameBox" TabIndex="0" Height="30" ToolTip="أدخل رقم الدخول الخاص بك — كل موظف له رقم"/>

                            <TextBlock Text="كلمة المرور" Style="{StaticResource FieldLabel}"/>
                            <Grid>
                                <PasswordBox x:Name="PasswordBox" TabIndex="1" Height="30" KeyDown="PasswordBox_KeyDown" PasswordChanged="PasswordBox_Changed"/>
                                <TextBox x:Name="PasswordText" TabIndex="1" Height="30" Visibility="Collapsed" TextChanged="PasswordText_Changed"/>
                            </Grid>
                            <CheckBox x:Name="ShowPassChk" Content="👁 إظهار كلمة السر أثناء الكتابة" Margin="0,6,0,0" Checked="ShowPass_Toggled" Unchecked="ShowPass_Toggled"/>

                            <CheckBox x:Name="RememberMe" Content="تذكرني على هذا الجهاز" Margin="0,12,0,0" TabIndex="2"/>

                            <Button x:Name="LoginBtn" Content="🔐 تسجيل الدخول" Style="{StaticResource ErpPrimaryButton}"
                                    Margin="0,18,0,0" HorizontalAlignment="Stretch" Click="Login_Click" TabIndex="3" IsDefault="True"/>

                            <TextBlock x:Name="MsgText" Text="" Foreground="#DC2626" TextWrapping="Wrap" Margin="0,12,0,0"
                                       HorizontalAlignment="Center" FontSize="11.5" TextAlignment="Center"/>

                            <!-- §v1.50.30: طوارئ المدير — بدل الطريق المسدود «راجع مسؤول النظام» حين يكون المستخدم هو المسؤول -->
                            <Button x:Name="EmergencyBtn" Content="🔓 فك قفل حساب المدير — طوارئ" Style="{StaticResource ErpButton}"
                                    Margin="0,10,0,0" HorizontalAlignment="Stretch" FontSize="11.5" Click="EmergencyUnlock_Click"
                                    ToolTip="يفك قفل حساب المدير ويعيد كلمة مؤقتة Admin@123 تُغيَّر إجبارياً عند أول دخول — على جهازك أنت فقط"/>
                            <TextBlock x:Name="DbHintText" Text="" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,10,0,0"
                                       HorizontalAlignment="Center" FontSize="11" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </DockPanel>
        </Border>

        <!-- شريط سفلي: اسم النظام والإصدار -->
        <TextBlock Text="نظام التصنيع — النظام المتكامل لإدارة عمليات التصنيع © 2026" Foreground="#94A3B8" FontSize="11"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12"/>
    </Grid>
</Window>
