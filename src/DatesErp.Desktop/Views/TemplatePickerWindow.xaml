<Window x:Class="DatesErp.Desktop.Views.TemplatePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="اختيار قالب" Height="420" Width="560" FlowDirection="RightToLeft" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Text="📋 قوالب خطط الإنتاج المحفوظة — اختر قالباً لتحميل بنوده" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,8,0,0">
            <Button Content="✅ تحميل" Style="{StaticResource ErpPrimaryButton}" Click="Ok_Click" Width="90"/>
            <Button Content="إلغاء" Style="{StaticResource ErpButton}" Click="Cancel_Click" Width="80" Margin="8,0,0,0"/>
        </StackPanel>
        <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="رقم القالب" Binding="{Binding DocumentNumber}" Width="120"/>
                <DataGridTextColumn Header="اسم القالب" Binding="{Binding PlanTitle}" Width="*"/>
                <DataGridTextColumn Header="بنود" Binding="{Binding Items.Count}" Width="60"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
