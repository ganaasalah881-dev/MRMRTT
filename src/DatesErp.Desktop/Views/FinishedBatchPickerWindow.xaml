<Window x:Class="DatesErp.Desktop.Views.FinishedBatchPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="اختيار دفعة تامة للتسليم — جميع الأرصدة المتاحة معروضة فوراً" Width="1100" Height="600"
        FlowDirection="RightToLeft" WindowStartupLocation="CenterOwner"
        Background="#F8FAFC" ShowInTaskbar="False" ResizeMode="CanResize">
    <DockPanel Margin="12">
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,8" Padding="10">
            <StackPanel>
                <TextBlock Text="📦 جميع الأرصدة التامة المتاحة معروضة فوراً — اختر دفعة لتنزل تلقائياً إلى إذن التسليم" FontWeight="Bold" FontSize="12" Margin="0,0,0,6"/>
                <TextBlock Text="مرتبة FIFO: الأقدم إنتاجاً/استلاماً أولاً. التنبيه يظهر إن اخترت دفعة حديثة بينما توجد أقدم لنفس العميل." TextWrapping="Wrap" FontSize="11" Foreground="#666" Margin="0,0,0,6"/>
                <DockPanel>
                    <TextBlock Text="تصفية اختيارية:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,8,0"/>
                    <TextBox x:Name="SearchBox" FontSize="13" Padding="6,4" TextChanged="SearchBox_TextChanged" ToolTip="اختياري — اتركه فارغاً لعرض الكل، أو اكتب اسم عميل / صنف / دفعة"/>
                    <Button Content="عرض الكل" Style="{StaticResource ErpButton}" Margin="8,0,0,0" Click="ShowAll_Click"/>
                </DockPanel>
                <TextBlock x:Name="CountText" Text="—" FontSize="11" Foreground="#555" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top" Style="{StaticResource WhiteCard}" Margin="0,0,0,8">
            <DataGrid x:Name="BatchesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      RowHeight="30" FontSize="12.5" CanUserAddRows="False"
                      MouseDoubleClick="BatchesGrid_DoubleClick"
                      SelectionMode="Single" SelectionUnit="FullRow">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="تاريخ الإنتاج" Binding="{Binding ProductionDate, StringFormat=dd/MM/yyyy}" Width="100"/>
                    <DataGridTextColumn Header="العميل" Binding="{Binding CustomerName}" Width="*"/>
                    <DataGridTextColumn Header="الصنف" Binding="{Binding ProductName}" Width="140"/>
                    <DataGridTextColumn Header="الدفعة" Binding="{Binding LotCode}" Width="110"/>
                    <DataGridTextColumn Header="الرصيد كرتون" Binding="{Binding Packages, StringFormat=N0}" Width="100"/>
                    <DataGridTextColumn Header="الرصيد كجم" Binding="{Binding Qty, StringFormat=N1}" Width="100"/>
                    <DataGridTextColumn Header="الوحدة" Binding="{Binding Unit}" Width="70"/>
                    <DataGridTextColumn Header="العبوة" Binding="{Binding PackName}" Width="100"/>
                    <DataGridTextColumn Header="الصفة" Binding="{Binding Grade}" Width="90"/>
                    <DataGridTextColumn Header="أيام بالمخزن" Binding="{Binding StorageDays}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Left">
            <Button Content="✅ اختيار" Style="{StaticResource ErpPrimaryButton}" Margin="0,0,8,0" Click="Ok_Click" IsDefault="True"/>
            <Button Content="✖ إلغاء" Style="{StaticResource ErpButton}" Click="Cancel_Click" IsCancel="True"/>
        </StackPanel>
        <TextBlock Text="تلميح: جميع الأرصدة ظاهرة فوراً — نقر مزدوج للاختيار. إن اخترت دفعة حديثة بينما توجد أقدم لنفس العميل، سيظهر تنبيه FIFO." TextWrapping="Wrap" FontSize="11" Foreground="#666" Margin="0,8,0,0" DockPanel.Dock="Bottom"/>
    </DockPanel>
</Window>
