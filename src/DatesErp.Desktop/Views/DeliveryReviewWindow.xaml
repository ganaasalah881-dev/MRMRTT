<Window x:Class="DatesErp.Desktop.Views.DeliveryReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="مراجعة التسليم قبل الحفظ" Height="360" Width="720"
        WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft">
    <!-- §7 أمر شاشة التسليم — شاشة المراجعة: الصنف | الصفة | المتاح | المسلَّم قبل الحفظ -->
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="راجع الكميات قبل الحفظ: التوزيع تم آلياً FIFO على دفعات الصنف (الأقدم استلاماً بالتام أولاً ثم الأقدم إنتاجاً) دون دمج أو فقدان تتبع. الأصناف غير المطلوبة لا تظهر في المستند."/>
        <DataGrid x:Name="ReviewGrid" Grid.Row="1" RowHeight="28" IsReadOnly="True" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="الصنف" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="الصفة" Binding="{Binding Grade}" Width="120"/>
                <DataGridTextColumn Header="المتاح (كرتون)" Binding="{Binding Avail}" Width="110"/>
                <DataGridTextColumn Header="المسلَّم (كرتون)" Binding="{Binding Delivered}" Width="110"/>
                <DataGridTextColumn Header="توزيع الدفعات" Binding="{Binding Lots}" Width="180"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0">
            <Button Content="✔ تأكيد وحفظ المستند" Width="180" Height="32" Margin="0,0,8,0" Click="Ok_Click"/>
            <Button Content="✖ رجوع للتعديل" Width="150" Height="32" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
