<Window x:Class="DatesErp.Desktop.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="200" Width="420" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" FlowDirection="RightToLeft" Background="#F4F6F5">
    <StackPanel Margin="20">
        <TextBlock x:Name="PromptText" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <TextBox x:Name="ValueBox" FontSize="14" Padding="8,6"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,16,0,0">
            <Button Content="موافق" Style="{StaticResource PrimaryButton}" Click="Ok_Click" IsDefault="True"/>
            <Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Click="Cancel_Click" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
