<UserControl x:Class="DatesErp.Desktop.Views.Screens.FinishedGoodsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <!-- §بلا تمرير: الأقسام ثابتة أعلى وأسفل · الجدول الرئيسي يملأ الواجهة -->
    <DockPanel LastChildFill="True">
            <!-- رأس السند -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,8">
                <StackPanel>
                    <Border Style="{StaticResource SecHeader}" Margin="-12,-12,-12,8">
                        <TextBlock Text="📦 أمر تسليم الإنتاج التام — يحرره مدير الإنتاج بعد فحص جودة معتمد" FontSize="12" FontWeight="Bold" Foreground="#0A246A"/>
                    </Border>
                    <WrapPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="أمر الإنتاج (له فحص معتمد):" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="OrderBox" Width="320" SelectionChanged="Order_Changed"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="رقم السند (تلقائي):" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="DocNoBox" Width="170" IsReadOnly="True" Background="#F0F0F0"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="تاريخ التسليم:" Style="{StaticResource FieldLabel}"/>
                            <DatePicker x:Name="DateBox" Width="150"/>
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- بنود التسليم -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,8">
                <StackPanel>
                    <Border Style="{StaticResource SecHeader}" Margin="-12,-12,-12,8">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="📋 بنود التسليم — خيارات: كامل المتاح / نصف المتاح / استبعاد الصنف" FontSize="12" FontWeight="Bold" Foreground="#0A246A"/>
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <Button Content="⬇ تسليم كامل المتاح لكل البنود" Style="{StaticResource ErpButton}" Click="AllFull_Click"/>
                                <Button Content="½ نصف المتاح لكل البنود" Style="{StaticResource ErpButton}" Click="AllHalf_Click"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <DataGrid x:Name="ItemsGrid" Height="124" RowHeight="30" IsReadOnly="False">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="تضمين" Binding="{Binding Included, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                            <DataGridTextColumn Header="الصنف المنتج" Binding="{Binding ProductName}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="الدفعة" Binding="{Binding LotCode}" Width="120" IsReadOnly="True"/>
                            <DataGridTextColumn Header="العبوات" Binding="{Binding Packages}" Width="90" IsReadOnly="True"/>
                            <DataGridTextColumn Header="الوزن المكافئ (كجم)" Binding="{Binding Weight}" Width="120" IsReadOnly="True"/>
                            <DataGridTextColumn Header="الكمية المطلوب تسليمها (كجم)" Binding="{Binding DeliverQty, UpdateSourceTrigger=PropertyChanged}" Width="170"/>
                            <DataGridTextColumn Header="المستلم فعلياً (كجم)" Binding="{Binding ReceivedQty}" Width="140" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- قسم أمين المخزن -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,8" Background="#EFF6FF">
                <StackPanel>
                    <Border Style="{StaticResource SecHeader}" Margin="-12,-12,-12,8" Background="#DBEAFE">
                        <TextBlock Text="🏬 قسم أمين المخزن — سند الاستلام المخزني هو وحده ما يؤثر على أرصدة مخزن التام" FontSize="12" FontWeight="Bold" Foreground="#1E40AF"/>
                    </Border>
                    <WrapPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="الكمية المستلمة للبند المحدد (كرتون) — فارغ = كامل المتبقي:" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="ReceiveQtyBox" Width="220" Text=""/>
                        </StackPanel>
                        <Button x:Name="ReceiveBtn" Content="📥 تنفيذ سند الاستلام" Style="{StaticResource ErpApproveButton}" VerticalAlignment="Bottom" Click="Receive_Click"/>
                        <Button x:Name="UnapproveBtn" Content="🔓 إلغاء السند وعكس الأرصدة" Style="{StaticResource ErpDangerButton}" VerticalAlignment="Bottom" Click="Unapprove_Click"/>
                    </WrapPanel>
                    <Border x:Name="ImpactBox" Background="White" BorderBrush="#94A3B8" BorderThickness="1" Padding="8" Margin="0,10,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="ImpactText" FontSize="11.5" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- سجل السندات -->
            <Border Style="{StaticResource WhiteCard}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="سندات تسليم الإنتاج (نقر مزدوج للفتح)" FontWeight="Bold" FontSize="12" Foreground="#0A246A" Margin="0,0,0,6"/>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="🔍 بحث وفلترة:" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="RecSearchBox" Width="340" TextChanged="RecSearch_Changed" VerticalAlignment="Center"/>
                    </StackPanel>
                    <DataGrid x:Name="ReceiptsGrid" RowHeight="30" FontSize="13.5" ColumnHeaderHeight="38" MouseDoubleClick="ReceiptsGrid_DoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="رقم السند" Binding="{Binding DocNo}" Width="130"/>
                            <DataGridTextColumn Header="سند الاستلام" Binding="{Binding ReceiptNo}" Width="130"/>
                            <DataGridTextColumn Header="الأمر" Binding="{Binding OrderNo}" Width="120"/>
                            <DataGridTextColumn Header="التاريخ" Binding="{Binding Date}" Width="110"/>
                            <DataGridTextColumn Header="الإجمالي (كجم)" Binding="{Binding Total}" Width="110"/>
                            <DataGridTextColumn Header="الحالة" Binding="{Binding StatusAr}" Width="110"/>
                            <DataGridTextColumn Header="الاستلام" Binding="{Binding ReceiptStatusAr}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
    </DockPanel>
</UserControl>
