<UserControl x:Class="DatesErp.Desktop.Views.Screens.SystemInfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <!-- §بلا تمرير: البطاقات جنباً إلى جنب في شبكة، وكل بطاقة تمرر داخلها عند الحاجة فقط -->
    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="الإعدادات ومعلومات النظام" Style="{StaticResource SectionTitle}"/>
        <UniformGrid Grid.Row="1" Columns="3" Margin="0,8,0,0">

        <!-- ═══ بيانات الشركة والهوية البصرية — تقرأ منها كل النماذج والتقارير وشاشة الدخول ═══ -->
        <Border Style="{StaticResource Card}" Margin="0,0,10,10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource SecHeader}" Margin="-14,-14,-14,10">
                    <TextBlock Text="🏢 بيانات الشركة والهوية البصرية (الشعار يظهر في الدخول والتقارير والمطبوعات)" FontSize="12" FontWeight="Bold" Foreground="#0A246A"/>
                </Border>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="190"/>
                    </Grid.ColumnDefinitions>
                    <WrapPanel Grid.Column="0">
                        <StackPanel Margin="0,0,16,6">
                            <TextBlock Text="اسم الشركة (عربي) *:" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="CompNameArBox" Width="320"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,6">
                            <TextBlock Text="اسم الشركة (إنجليزي):" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="CompNameEnBox" Width="240"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,6">
                            <TextBlock Text="العنوان:" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="CompAddressBox" Width="320"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,6">
                            <TextBlock Text="الهاتف:" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="CompPhoneBox" Width="180"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,6">
                            <TextBlock Text="البريد الإلكتروني:" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="CompEmailBox" Width="240"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,6">
                            <TextBlock Text="الرقم الضريبي:" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="CompTaxBox" Width="180"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,6">
                            <TextBlock Text="تذييل التقارير والمطبوعات:" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="CompFooterBox" Width="560"/>
                        </StackPanel>
                    </WrapPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock Text="شعار الشركة:" Style="{StaticResource FieldLabel}" HorizontalAlignment="Center"/>
                        <Border Width="130" Height="130" Background="White" BorderBrush="#94A3B8" BorderThickness="1.5" CornerRadius="4" Margin="0,4">
                            <Grid>
                                <Image x:Name="LogoPreview" Stretch="Uniform" Margin="6"/>
                                <TextBlock x:Name="LogoPlaceholder" Text="لم يُرفع شعار" Foreground="#9CA3AF" FontSize="11"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Button Content="🖼️ رفع الشعار" Style="{StaticResource ErpButton}" Click="UploadLogo_Click" HorizontalAlignment="Stretch" Margin="3,6"/>
                        <Button Content="إزالة الشعار" Style="{StaticResource ErpDangerButton}" Click="RemoveLogo_Click" HorizontalAlignment="Stretch" Margin="3,2"/>
                    </StackPanel>
                </Grid>
                <Button Content="🧮 فحص مطابقة المخزون" Style="{StaticResource ErpButton}" Click="IntegrityCheck_Click"
                        HorizontalAlignment="Stretch" Margin="3,6"
                        ToolTip="يقارن كل رصيد بمجموع حركاته الموقّعة منذ الصفر ويعرض الفروقات إن وجدت"/>
                <Button Content="💾 حفظ بيانات الشركة" Style="{StaticResource ErpPrimaryButton}" Click="SaveCompany_Click"
                        HorizontalAlignment="Right" Margin="0,10,0,0"/>
            </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,10,10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="معلومات الإصدار (§31 — إصدار التطبيق منفصل عن إصدار قاعدة البيانات)" FontWeight="Bold" FontSize="15" Foreground="#1B4D3E" Margin="0,0,0,8"/>
                <TextBlock x:Name="AppVersionText" FontSize="14" Margin="0,2"/>
                <TextBlock x:Name="DbVersionText" FontSize="14" Margin="0,2"/>
            </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,10,10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="إعداد الاتصال المركزي" FontWeight="Bold" FontSize="15" Foreground="#1B4D3E" Margin="0,0,0,8"/>
                <TextBlock x:Name="ServerText" FontSize="14" Margin="0,2"/>
                <TextBlock x:Name="DbText" FontSize="14" Margin="0,2"/>
                <TextBlock x:Name="AuthText" FontSize="14" Margin="0,2"/>
                <Button Content="✏ تعديل إعداد الاتصال" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right"
                        Margin="0,8,0,0" Click="EditConnection_Click"/>
            </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ══ §الفحص الذاتي: يجعل «هل العطل من جهازي؟» سؤالاً له جواب ══ -->
        <Border Style="{StaticResource Card}" Margin="0,0,10,10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="🩺 الفحص الذاتي" FontWeight="Bold" FontSize="15" Foreground="#1B4D3E" Margin="0,0,0,4"/>
                <TextBlock FontSize="12" Foreground="#555" TextWrapping="Wrap" Margin="0,0,0,8"
                           Text="يفحص الاتصال · اكتمال جداول القاعدة وأعمدتها · البيانات الأولية · المخازن ومخططات الترقيم وموارد الصلاحيات · اتساق الأرصدة والالتزامات والتتبع · إنشاء كل شاشة ووجود معالج لكل زر. ثم يكتب تقريراً نصياً ترسله للمطوّر بدل وصف المشكلة بالكلام."/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="🩺 تشغيل الفحص الذاتي الآن" Style="{StaticResource ErpPrimaryButton}" Click="RunSelfTest_Click"/>
                    <Button Content="📂 فتح مجلد التقارير" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="OpenReportFolder_Click"/>
                </StackPanel>
                <TextBlock x:Name="SelfTestResult" FontSize="13" FontWeight="Bold" Margin="0,8,0,0" TextWrapping="Wrap"/>
                <TextBlock x:Name="SelfTestPath" FontSize="11" Foreground="#666" Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="هذا الجهاز" FontWeight="Bold" FontSize="15" Foreground="#1B4D3E" Margin="0,0,0,8"/>
                <TextBlock x:Name="MachineText" FontSize="14" Margin="0,2"/>
                <TextBlock x:Name="UserText" FontSize="14" Margin="0,2"/>
            </StackPanel>
            </ScrollViewer>
        </Border>
        </UniformGrid>
    </Grid>
</UserControl>
