<UserControl x:Class="DatesErp.Desktop.Views.Screens.ReceivingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             FlowDirection="RightToLeft">
    <!-- §بلا تمرير: الأقسام ثابتة أعلى وأسفل · الجدول الرئيسي يملأ الواجهة -->
    <DockPanel LastChildFill="True">
            <!-- بيانات السند -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,8">
                <StackPanel>
                    <Border Style="{StaticResource SecHeader}" Margin="-12,-12,-12,8">
                        <TextBlock Text="📥 بيانات سند الاستلام" FontSize="12" FontWeight="Bold" Foreground="#0A246A"/>
                    </Border>
                    <TextBlock x:Name="DocState" Text="حالة المستند: مستند جديد — أدخل البيانات ثم اضغط حفظ" FontSize="12" FontWeight="Bold" Foreground="#14532D" Margin="0,0,0,8"/>
                    <WrapPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="العميل المورد *:" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CustomerBox" Width="240" DisplayMemberPath="CustomerName" SelectedValuePath="Id"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="رقم المستند (تلقائي):" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="DocNoBox" Width="170" IsReadOnly="True" Background="#F0F0F0"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="تاريخ الوصول *:" Style="{StaticResource FieldLabel}"/>
                            <DatePicker x:Name="ArrivalDate" Width="150"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="تاريخ الاستلام *:" Style="{StaticResource FieldLabel}"/>
                            <DatePicker x:Name="ReceivedDate" Width="150"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="موظف الاستلام:" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="EmployeeBox" Width="200" DisplayMemberPath="FullName" SelectedValuePath="Id"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="رقم الحاوية/الشاحنة:" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="ContainerBox" Width="180" ToolTip="مثال: CXLU-8841203" LostFocus="ContainerBox_LostFocus"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="🏬 مخزن الاستلام الفعلي:" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="WarehouseBox" Width="210" DisplayMemberPath="WarehouseNameAr" SelectedValuePath="Id"
                                      ToolTip="المخزن الذي وصلت إليه الحاوية فعلياً (الرئيسي / الخام 2 / الثلاجة...) — يقيَّد الوارد فيه عند الاعتماد"/>
                        </StackPanel>
                    </WrapPanel>
                    <TextBlock x:Name="DuplicateWarn" TextWrapping="Wrap" Foreground="#B45309" FontWeight="Bold" FontSize="11" Margin="0,4,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- بنود الشحنة — الإدخال المباشر من الجدول نفسه (1.50.54) -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,8" DockPanel.Dock="Top">
                <StackPanel>
                    <Border Style="{StaticResource SecHeader}" Margin="-12,-12,-12,8">
                        <TextBlock Text="📦 بنود الشحنة — الجدول نفسه هو نموذج الإدخال: اضغط على رقم الصنف أو اسم الصنف داخل الصف لاختيار الصنف، والنظام يعبئ بياناته تلقائياً" FontSize="12" FontWeight="Bold" Foreground="#0A246A" TextWrapping="Wrap"/>
                    </Border>
                    <TextBlock Text="التعليمات: جميع الأصناف معروضة فوراً — اضغط على (رقم الصنف) أو (اسم الصنف) في صف جديد → تظهر قائمة بجميع الأصناف مباشرةً — اختر واحداً لينزل تلقائياً رقمه واسمه ووحدته للقراءة فقط في نفس الصف. ثم أدخل مباشرة: نوع العبوة / العدد / الوزن / الكمية. صف جديد جاهز يظهر تلقائياً بعد اختيار صحيح. يمكنك إضافة عدة أصناف دون مغادرة الجدول. التصفية اختيارية فقط إن أردت."
                               TextWrapping="Wrap" Foreground="#14532D" FontSize="11" Margin="0,0,0,8" FontWeight="SemiBold"/>
                    <TextBlock Text="اختر المعالجة نعم/لا لكل بند. عند نعم اختر حتى تاريخ في نفس الصف؛ أي تاريخ من تاريخ الاستلام فما بعده. الحجز المخزني يبدأ عند الاعتماد وينتهي آلياً من بداية اليوم المختار."
                               TextWrapping="Wrap" Foreground="#92400E" FontSize="11" Margin="0,0,0,6"/>

                    <DataGrid x:Name="ItemsGrid" Height="260" MinHeight="200" IsReadOnly="False" CanUserAddRows="False" CanUserDeleteRows="False" RowHeight="38" FontSize="13" Margin="0,4,0,0" ScrollViewer.HorizontalScrollBarVisibility="Auto" AutoGenerateColumns="False" LoadingRow="ItemsGrid_LoadingRow" Loaded="ItemsGrid_Loaded">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="White"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsInvalid}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource InvalidRowBrush}"/>
                                            <Setter Property="ToolTip" Value="{Binding ValidationError}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                            <!-- م -->
                            <DataGridTextColumn Header="م" Binding="{Binding RowNo}" Width="40" IsReadOnly="True"/>

                            <!-- رقم الصنف — اختيار مباشر -->
                            <DataGridTemplateColumn Header="رقم الصنف *" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding DisplayCode}" Click="ProductCode_Click" Tag="{Binding}"
                                                ToolTip="اضغط لاختيار الصنف — بحث برقم أو اسم"
                                                Padding="6,2" HorizontalContentAlignment="Right"
                                                Style="{StaticResource ErpButton}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- اسم الصنف — نفس البحث -->
                            <DataGridTemplateColumn Header="اسم الصنف *" Width="200" MinWidth="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding DisplayName}" Click="ProductName_Click" Tag="{Binding}"
                                                ToolTip="اضغط لاختيار الصنف — نفس البحث برقم أو اسم"
                                                Padding="6,2" HorizontalContentAlignment="Right"
                                                Style="{StaticResource ErpButton}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- الوحدة — للقراءة فقط من بطاقة الصنف -->
                            <DataGridTextColumn Header="الوحدة" Binding="{Binding ReceiptUnit}" Width="80" IsReadOnly="True"/>

                            <!-- العبوة — اختيار -->
                            <DataGridTemplateColumn Header="العبوة / النوع" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox x:Name="PackCombo" DisplayMemberPath="PackageNameAr" SelectedValuePath="Id"
                                                  SelectedValue="{Binding PackId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding IsEditable}"
                                                  SelectionChanged="PackCombo_SelectionChanged"
                                                  Tag="{Binding}"
                                                  ToolTip="اختر نوع العبوة — يعبئ وزنها تلقائياً"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- عدد الوحدات -->
                            <DataGridTemplateColumn Header="عدد الوحدات *" Width="95">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding PackageCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding IsEditable}"
                                                 PreviewTextInput="Number_PreviewTextInput"
                                                 LostFocus="PackageCount_LostFocus"
                                                 Tag="{Binding}"
                                                 Padding="4,2"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- وزن العبوة -->
                            <DataGridTemplateColumn Header="وزن العبوة (كجم) *" Width="115">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding UnitWeightKg, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                                 IsEnabled="{Binding IsEditable}"
                                                 PreviewTextInput="Decimal_PreviewTextInput"
                                                 LostFocus="UnitWeight_LostFocus"
                                                 Tag="{Binding}"
                                                 Padding="4,2"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- الكمية -->
                            <DataGridTemplateColumn Header="الكمية (كجم) *" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding QtyKg, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N1}"
                                                 IsEnabled="{Binding IsEditable}"
                                                 PreviewTextInput="Decimal_PreviewTextInput"
                                                 Tag="{Binding}"
                                                 Padding="4,2" FontWeight="Bold"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- المعالجة -->
                            <DataGridTemplateColumn Header="المعالجة *" Width="85">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox SelectedItem="{Binding TreatmentChoiceAr, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding IsEditable}" ToolTip="اختيار إلزامي لكل بند: نعم أو لا">
                                            <ComboBox.ItemsSource><x:Array Type="sys:String"><sys:String>نعم</sys:String><sys:String>لا</sys:String></x:Array></ComboBox.ItemsSource>
                                        </ComboBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Width="155">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <StackPanel.Style><Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers><DataTrigger Binding="{Binding ShowUntilDate}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                            </Style></StackPanel.Style>
                                            <TextBlock Text="حتى" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="11"/>
                                            <DatePicker Width="105" SelectedDate="{Binding TreatmentUntilDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        IsEnabled="{Binding IsEditable}" FontSize="11"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="حالة المعالجة" Binding="{Binding TreatmentStateAr}" Width="190" IsReadOnly="True" FontSize="11"/>

                            <DataGridComboBoxColumn x:Name="ItemStatusColumn" IsReadOnly="False" Header="حالة البند" SelectedItemBinding="{Binding Status, UpdateSourceTrigger=PropertyChanged}" Width="110">
                                <DataGridComboBoxColumn.ItemsSource>
                                    <x:Array Type="sys:String">
                                        <sys:String>مستلم</sys:String>
                                        <sys:String>مرفوض/تالف</sys:String>
                                        <sys:String>معلّق لاحقاً</sys:String>
                                    </x:Array>
                                </DataGridComboBoxColumn.ItemsSource>
                            </DataGridComboBoxColumn>

                            <DataGridTemplateColumn Header="حذف" Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="✕" Padding="4,0" Style="{StaticResource ErpDangerButton}" Click="RemoveItem_Click" IsEnabled="{Binding IsEditable}" Tag="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="🔄 تحديث حالات المعالجة" Style="{StaticResource ErpButton}" Click="RefreshTreatment_Click" Margin="0,0,12,0"/>
                        <Button Content="📋 نسخ من إيصال سابق" Style="{StaticResource ErpButton}" Click="CopyFromPrevious_Click" Margin="0,0,12,0" ToolTip="نسخ بنود من إيصال سابق (8) قوالب ونسخ سندات"/>
                        <TextBlock Text="إجمالي وزن الشحنة:" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock x:Name="GrandTotal" Text="0 كجم" FontWeight="Bold" FontSize="14" Foreground="#14532D" Margin="8,0,0,0"/>
                        <TextBlock Text="  |  عدد البنود:" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ItemsCount" Text="0" FontWeight="Bold" FontSize="14" Foreground="#0A246A" Margin="8,0,0,0"/>
                        <TextBlock Text="  |  إجمالي العبوات:" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock x:Name="PackagesTotal" Text="0" FontWeight="Bold" FontSize="14" Foreground="#92400E" Margin="8,0,0,0"/>
                        <TextBlock x:Name="ContainerSummary" Text="" FontWeight="Bold" FontSize="11" Foreground="#7C3AED" VerticalAlignment="Center" Margin="18,0,0,0"/>
                    </StackPanel>
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Text="البيان والتفاصيل:" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="NotesBox" Width="700" HorizontalAlignment="Right" ToolTip="أدخل بيان أو تفاصيل الشحنة الواردة..."/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- حالة الاعتماد -->
            <Border x:Name="LockBanner" DockPanel.Dock="Top" Background="#FEF3C7" BorderBrush="#D97706" BorderThickness="1" Padding="10" Margin="0,0,0,8" Visibility="Collapsed">
                <TextBlock Text="🔒 مقفل — أمر استلام معتمد (للتعديل: ألغِ الاعتماد بصلاحية)" Foreground="#92400E" FontWeight="Bold" FontSize="12"/>
            </Border>

            <!-- سجل أوامر الاستلام -->
            <Border Style="{StaticResource WhiteCard}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="نتائج البحث — سندات الاستلام (تظهر بعد الضغط على «بحث / القائمة»، نقر مزدوج يفتح السند في هذه الواجهة)" FontWeight="Bold" FontSize="12" Foreground="#0A246A" Margin="0,0,0,6"/>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="🔍 بحث وفلترة:" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="ShipsSearchBox" Width="340" TextChanged="ShipsSearch_Changed" VerticalAlignment="Center"/>
                    </StackPanel>
                    <DataGrid x:Name="ShipGrid" RowHeight="30" FontSize="13.5" ColumnHeaderHeight="38" MouseDoubleClick="ShipGrid_DoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="رقم السند" Binding="{Binding DocNo}" Width="140"/>
                            <DataGridTextColumn Header="العميل" Binding="{Binding Customer}" Width="*"/>
                            <DataGridTextColumn Header="التاريخ" Binding="{Binding Date}" Width="110"/>
                            <DataGridTextColumn Header="الوزن (كجم)" Binding="{Binding Weight}" Width="110"/>
                            <DataGridTextColumn Header="الحالة" Binding="{Binding StatusAr}" Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
    </DockPanel>
</UserControl>
