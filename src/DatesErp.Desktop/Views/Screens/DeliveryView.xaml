<UserControl x:Class="DatesErp.Desktop.Views.Screens.DeliveryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <!-- §بلا تمرير: الأقسام ثابتة أعلى وأسفل · الجدول الرئيسي يملأ الواجهة -->
    <DockPanel LastChildFill="True">
            <!-- رأس السند -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,8">
                <StackPanel>
                    <Border Style="{StaticResource SecHeader}" Margin="-12,-12,-12,8">
                        <TextBlock Text="🚛 إذن خروج وتسليم بضاعة للعملاء — من رصيد العميل في مخزن التام فقط" FontSize="12" FontWeight="Bold" Foreground="#0A246A"/>
                    </Border>
                    <WrapPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="العميل:" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CustomerBox" Width="260" DisplayMemberPath="CustomerName" SelectedValuePath="Id" SelectionChanged="Customer_Changed"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="رقم السند (تلقائي):" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="DocNoBox" Width="170" IsReadOnly="True" Background="#F0F0F0"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="تاريخ التسليم:" Style="{StaticResource FieldLabel}"/>
                            <DatePicker x:Name="DateBox" Width="150"/>
                        </StackPanel>
                        <Border Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1" Padding="10,6" VerticalAlignment="Bottom">
                            <TextBlock x:Name="BalanceChip" Text="رصيد العميل: —" FontWeight="Bold" FontSize="12" Foreground="#166534"/>
                        </Border>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- رصيد العميل -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,8">
                <StackPanel>
                    <Border Style="{StaticResource SecHeader}" Margin="-12,-12,-12,8">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="📊 رصيد العميل المتاح في مخزن التام" FontSize="12" FontWeight="Bold" Foreground="#0A246A"/>
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <Button Content="⬇ تسليم كامل الكمية المتاحة" Style="{StaticResource ErpButton}" Click="DeliverAll_Click"/>
                                <Button Content="➡ متابعة التسليم (توزيع FIFO + مراجعة)" Style="{StaticResource ErpButton}" Click="ContinueDelivery_Click"/>
                                <Button Content="🗑 حذف السطر المحدد" Style="{StaticResource ErpDangerButton}" Click="RemoveRow_Click"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <!-- §أمر شاشة التسليم — الترتيب الافتراضي FIFO: الأقدم استلاماً بالتام أولاً ثم الأقدم إنتاجاً (§2) -->
                    <DataGrid x:Name="BalanceGrid" Height="140" RowHeight="28" MouseDoubleClick="Balance_DoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الصنف" Binding="{Binding ProductName}" Width="*"/>
                            <DataGridTextColumn Header="الكود" Binding="{Binding Code}" Width="90"/>
                            <DataGridTextColumn Header="الصفة" Binding="{Binding Grade}" Width="110"/>
                            <DataGridTextColumn Header="وزن الكرتون (كجم)" Binding="{Binding CartonWeight}" Width="100"/>
                            <DataGridTextColumn Header="الرصيد المتاح (كرتون)" Binding="{Binding Packages}" Width="110"/>
                            <DataGridTextColumn Header="الوزن المكافئ (كجم)" Binding="{Binding Qty}" Width="110"/>
                            <DataGridTextColumn Header="استلام التام" Binding="{Binding FgReceipt}" Width="95"/>
                            <DataGridTextColumn Header="تاريخ الإنتاج" Binding="{Binding Production}" Width="95"/>
                            <DataGridTextColumn Header="مدة البقاء (أيام)" Binding="{Binding StorageDays}" Width="95"/>
                            <DataGridTextColumn Header="رقم الخطة" Binding="{Binding PlanNo}" Width="110"/>
                            <DataGridTextColumn Header="رقم الأمر" Binding="{Binding OrderNo}" Width="110"/>
                            <DataGridTextColumn Header="الدفعة" Binding="{Binding LotCode}" Width="120"/>
                            <DataGridTextColumn Header="العبوة" Binding="{Binding PackName}" Width="100"/>
                            <DataGridTextColumn Header="حالة الفحص" Binding="{Binding QcStatus}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="نقر مزدوج على سطر الرصيد لإضافته إلى بنود التسليم" FontSize="11" Foreground="#555" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- بنود التسليم — الإدخال المباشر من الجدول (1.50.56) -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,8">
                <StackPanel>
                    <Border Style="{StaticResource SecHeader}" Margin="-12,-12,-12,8">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="📋 بنود إذن التسليم — الجدول نفسه هو النموذج: اضغط على الدفعة/الصنف للاختيار المباشر" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Button DockPanel.Dock="Left" Content="➕ صف جديد" Style="{StaticResource ErpButton}" Click="AddEmptyRow_Click" ToolTip="إضافة صف جديد — جميع الأرصدة التامة معروضة فوراً"/>
                            <Button DockPanel.Dock="Left" Content="⎘ تكرار الصف" Style="{StaticResource ErpButton}" Click="DuplicateRow_Delivery" Margin="6,0,0,0" ToolTip="ينسخ الصف المحدد (7-ج)"/>
                            <Button DockPanel.Dock="Left" Content="📥 استيراد Excel" Style="{StaticResource ErpButton}" Margin="6,0,0,0" ToolTip="استيراد بنود من Excel (7-د)"/>
                        </DockPanel>
                    </Border>
                    <TextBlock Text="التعليمات: جميع الأرصدة التامة المتاحة معروضة فوراً — اضغط على (الدفعة) أو (الصنف) داخل صف جديد → تظهر قائمة بكل الدفعات التامة المتاحة مرتبة FIFO من الأقدم إنتاجاً → اختر واحدة لتنزل تلقائياً مع رصيدها. إن اخترت دفعة حديثة بينما توجد أقدم لنفس العميل، سيظهر تنبيه FIFO. صف جديد يظهر تلقائياً بعد اختيار صحيح."
                               TextWrapping="Wrap" FontSize="11" Margin="0,0,0,6" FontWeight="SemiBold"/>
                    <DataGrid x:Name="ItemsGrid" Height="160" MinHeight="120" RowHeight="34" IsReadOnly="False" AutoGenerateColumns="False" CanUserAddRows="False">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="White"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsInvalid}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource InvalidRowBrush}"/>
                                        <Setter Property="ToolTip" Value="{Binding ValidationError}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="الدفعة *" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding LotCode}" Click="LotCode_Click" Tag="{Binding}" Style="{StaticResource ErpButton}" ToolTip="جميع الدفعات التامة معروضة فوراً — اختر مباشرة"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="الصنف *" Width="*" MinWidth="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding ProductName}" Click="ProductName_Click" Tag="{Binding}" Style="{StaticResource ErpButton}" ToolTip="جميع الأرصدة معروضة فوراً"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="الوحدة" Binding="{Binding Unit}" Width="80" IsReadOnly="True"/>
                            <DataGridTextColumn Header="العبوة" Binding="{Binding PackName}" Width="100" IsReadOnly="True"/>
                            <DataGridTextColumn Header="الرصيد المتاح كرتون" Binding="{Binding AvailablePackages}" Width="110" IsReadOnly="True"/>
                            <DataGridTextColumn Header="الرصيد كجم" Binding="{Binding AvailableQty}" Width="100" IsReadOnly="True"/>
                            <DataGridTextColumn Header="الكراتين المطلوبة *" Binding="{Binding Packages, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                            <DataGridTextColumn Header="الوزن المكافئ (كجم)" Binding="{Binding Qty}" Width="120" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="حذف" Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="✕" Padding="4,0" Style="{StaticResource ErpDangerButton}" Click="RemoveItem_Click" Tag="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- سجل التسليمات -->
            <Border Style="{StaticResource WhiteCard}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="سندات تسليم العملاء (نقر مزدوج للفتح)" FontWeight="Bold" FontSize="12" Foreground="#0A246A" Margin="0,0,0,6"/>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="🔍 بحث وفلترة:" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="DelivSearchBox" Width="340" TextChanged="DelivSearch_Changed" VerticalAlignment="Center"/>
                    </StackPanel>
                    <DataGrid x:Name="DeliveriesGrid" RowHeight="30" FontSize="13.5" ColumnHeaderHeight="38" MouseDoubleClick="DeliveriesGrid_DoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الرقم" Binding="{Binding DocNo}" Width="130"/>
                            <DataGridTextColumn Header="العميل" Binding="{Binding Customer}" Width="*"/>
                            <DataGridTextColumn Header="التاريخ" Binding="{Binding Date}" Width="110"/>
                            <DataGridTextColumn Header="الكراتين" Binding="{Binding Packages}" Width="90"/>
                            <DataGridTextColumn Header="الوزن المكافئ (كجم)" Binding="{Binding Qty}" Width="120"/>
                            <DataGridTextColumn Header="الحالة" Binding="{Binding StatusAr}" Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
    </DockPanel>
</UserControl>
