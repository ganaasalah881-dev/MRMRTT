<UserControl x:Class="DatesErp.Desktop.Views.Screens.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <!--
      §B90/§46 — مركز التقارير الموحد: معرض مصنّف قابل للبحث + مساحة عمل عريضة.
      §46 تطوير التصميم: هوية موحدة من القوالب المرجعية المعتمدة (ترويسة كحلية،
      لمسات ذهبية، بطاقات بيضاء مدوّرة، نصوص أردوازية) — كل الألوان من موارد الثيم
      بلا أي لون مضمّن، وسلوك الشاشة وأسماء العناصر كما هي دون تغيير.
      عند تشغيل التقرير يختفي المعرض ويمتد التقرير على كامل الواجهة، وزر «رجوع» يعيده.
    -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ListCol" Width="360"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══ معرض التقارير المصنّف — بحث + بطاقات، يختفي عند تشغيل التقرير ══ -->
        <Border x:Name="CatalogPanel" Grid.Column="0" Background="White"
                BorderBrush="{StaticResource ErpLineBrush}" BorderThickness="1" CornerRadius="10"
                Margin="0,0,10,0" ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="1" BlurRadius="6" Opacity="0.16" Color="{StaticResource NavyColor}"/>
            </Border.Effect>
            <DockPanel>
                <!-- ترويسة كحلية كهوية النماذج المرجعية + شارة عدّاد ذهبية -->
                <Border DockPanel.Dock="Top" Background="{StaticResource NavyBrush}"
                        BorderBrush="{StaticResource AccentBrush}" BorderThickness="0,0,0,2" Padding="12,10">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="📈 مركز التقارير" FontSize="14" FontWeight="Bold"
                                   Foreground="White" VerticalAlignment="Center"/>
                        <Border DockPanel.Dock="Left" Background="{StaticResource AccentBrush}" CornerRadius="10"
                                Padding="9,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock x:Name="ReportsCount" Text="" FontSize="10.5" FontWeight="Bold"
                                       Foreground="{StaticResource NavyBrush}" VerticalAlignment="Center"/>
                        </Border>
                    </DockPanel>
                </Border>

                <!-- بحث لحظي في المعرض -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,10,10,6">
                    <TextBlock Text="🔍 ابحث باسم التقرير:" FontSize="11.5" FontWeight="Bold"
                               Foreground="{StaticResource ErpInkBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="CatalogSearchBox" Width="190" TextChanged="CatalogSearch_Changed" VerticalAlignment="Center"
                             Padding="6,4" Background="{StaticResource ErpSurfaceBrush}"
                             BorderBrush="{StaticResource ErpLineBrush}"
                             ToolTip="فلترة لحظية لقائمة التقارير بالاسم"/>
                </StackPanel>

                <ListBox x:Name="ReportsList" SelectionChanged="Report_Selected" MouseDoubleClick="Report_DoubleClick"
                         BorderThickness="0" Background="Transparent" Padding="10,2,10,10"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <!-- §46 — قالب مجرد: البطاقة نفسها ترسم حالاتها (تحويم/تحديد)
                                 فلا يظهر الأزرق الافتراضي للنظام حول الحواف المدوّرة -->
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="Transparent" BorderThickness="0">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <!-- عنوان التصنيف: شريط ذهبي جانبي + نص كحلي على سطح فاتح -->
                                    <Border Background="{StaticResource ErpSurfaceBrush}" CornerRadius="6"
                                            Padding="8,6" Margin="0,10,0,5">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" Width="4" CornerRadius="2"
                                                    Background="{StaticResource AccentBrush}" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13.5"
                                                       Foreground="{StaticResource NavyBrush}" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="card" BorderBrush="{StaticResource ErpLineBrush}" BorderThickness="1"
                                    CornerRadius="8" Background="White" Padding="10,8" Margin="0,0,0,6">
                                <DockPanel>
                                    <Border x:Name="accent" DockPanel.Dock="Right" Width="3" CornerRadius="2"
                                            Background="{StaticResource AccentBrush}" Opacity="0.55" Margin="0,2,8,2"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding TitleAr}" FontSize="13.5" FontWeight="Bold"
                                                   Foreground="{StaticResource NavyBrush}" TextWrapping="Wrap"/>
                                        <TextBlock FontSize="11" Foreground="{StaticResource ErpMutedBrush}" Margin="0,3,0,0"
                                                   Text="{Binding Parameters.Count, StringFormat='{}{0} فلتر — نقرتان للتشغيل المباشر'}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True">
                                    <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                    <Setter TargetName="accent" Property="Opacity" Value="1"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                    <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource NavyBrush}"/>
                                    <Setter TargetName="card" Property="BorderThickness" Value="1.6"/>
                                    <Setter TargetName="card" Property="Background" Value="{StaticResource ErpSurfaceBrush}"/>
                                    <Setter TargetName="accent" Property="Opacity" Value="1"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ══ منطقة التقرير ══ -->
        <Border x:Name="ReportPanel" Grid.Column="1" Background="White"
                BorderBrush="{StaticResource ErpLineBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="1" BlurRadius="6" Opacity="0.16" Color="{StaticResource NavyColor}"/>
            </Border.Effect>
            <DockPanel>
                <!-- §46 — ترويسة مساحة العمل: عنوان كبير كحلي + وصف أردوازي على خط ذهبي،
                     رجوع يميناً وإجراءات الإخراج يساراً (طباعة/PDF/Excel) -->
                <Border DockPanel.Dock="Top" BorderBrush="{StaticResource AccentBrush}" BorderThickness="0,0,0,2"
                        Padding="0,0,0,10" Margin="0,0,0,10">
                    <DockPanel>
                        <Button x:Name="BackBtn" DockPanel.Dock="Right" Content="→ رجوع لمعرض التقارير"
                                Style="{StaticResource ErpButton}" Click="Back_Click"
                                Visibility="Collapsed" VerticalAlignment="Center"/>
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="🖨 طباعة" Style="{StaticResource ErpButton}" Click="Print_Click" Margin="0,0,8,0"/>
                            <Button Content="📄 PDF" Style="{StaticResource ErpButton}" Click="Pdf_Click" Margin="0,0,8,0"/>
                            <Button Content="📊 Excel" Style="{StaticResource ErpButton}" Click="Excel_Click"/>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock x:Name="ReportTitle" Text="اختر تقريراً من المعرض — نقرتان لتشغيله مباشرة"
                                       FontSize="20" FontWeight="Bold" Foreground="{StaticResource NavyBrush}" TextWrapping="Wrap"/>
                            <TextBlock x:Name="ReportSub" Text="" FontSize="11.5"
                                       Foreground="{StaticResource ErpMutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- §46 — شريط الفلاتر: بطاقة سطحية مميزة بترويسة كحلية وزر تشغيل بارز -->
                <Border DockPanel.Dock="Top" Background="{StaticResource ErpSurfaceBrush}"
                        BorderBrush="{StaticResource ErpLineBrush}" BorderThickness="1" CornerRadius="8"
                        Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="🔎 فلاتر التقرير — حدد ثم اضغط تشغيل" FontSize="12" FontWeight="Bold"
                                   Foreground="{StaticResource NavyBrush}"/>
                        <Border Height="2" Background="{StaticResource AccentBrush}" Opacity="0.55" Margin="0,6,0,10"/>
                        <DockPanel>
                            <Button x:Name="RunBtn" DockPanel.Dock="Left" Content="▶ تشغيل التقرير"
                                    Style="{StaticResource ErpPrimaryButton}" Click="Run_Click" VerticalAlignment="Bottom"/>
                            <WrapPanel x:Name="ParamsPanel">
                                <TextBlock Text="اختر تقريراً لعرض فلاتره هنا." FontSize="13.5"
                                           Foreground="{StaticResource ErpMutedBrush}" VerticalAlignment="Center"/>
                            </WrapPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- بطاقات المؤشرات -->
                <ScrollViewer DockPanel.Dock="Top" MaxHeight="120" VerticalScrollBarVisibility="Auto" Margin="0,0,0,6">
                    <WrapPanel x:Name="KpiPanel"/>
                </ScrollViewer>

                <!-- العدّاد والبحث السريع -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <TextBlock x:Name="RowsCount" Text="" FontSize="13" Foreground="{StaticResource ErpMutedBrush}"
                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔎 بحث سريع في النتائج:" FontSize="13.5" FontWeight="Bold"
                                   Foreground="{StaticResource ErpInkBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="QuickSearchBox" Width="340" FontSize="13.5" TextChanged="QuickSearch_Changed"
                                 Padding="6,4" Background="{StaticResource ErpSurfaceBrush}"
                                 BorderBrush="{StaticResource ErpLineBrush}"
                                 ToolTip="فلترة لحظية لكل أعمدة النتيجة — تعمل مع كل التقارير"/>
                    </StackPanel>
                </DockPanel>

                <!-- §الشكل الموحد: شريط معادلة الإقفال أسفل الجدول (يظهر فقط لمن يعرّف Equation) -->
                <Border x:Name="EquationBar" DockPanel.Dock="Bottom" Visibility="Collapsed"
                        Background="{StaticResource LightBgBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="12,8" Margin="0,8,0,0">
                    <TextBlock x:Name="EquationText" FontSize="13.5" FontWeight="Bold"
                               Foreground="{StaticResource ErpWarnBrush}" TextWrapping="Wrap" FlowDirection="RightToLeft"/>
                </Border>

                <!-- §46 — الجدول داخل بطاقة مدوّرة: ترويسة كحلية بنص أبيض، صفوف متبادلة بلون السطح،
                     وتلميح إرشادي عند الفراغ يختفي مع أول نتيجة -->
                <Border BorderBrush="{StaticResource ErpLineBrush}" BorderThickness="1" CornerRadius="8"
                        Background="White" ClipToBounds="True">
                    <Grid>
                        <DataGrid x:Name="ReportGrid" FontSize="14" RowHeight="36"
                                  ColumnHeaderHeight="42" GridLinesVisibility="All"
                                  HorizontalGridLinesBrush="{DynamicResource ThemeGridLineBrush}" VerticalGridLinesBrush="{DynamicResource ThemeGridLineBrush}"
                                  BorderThickness="0" Background="{DynamicResource ThemeTableBackgroundBrush}"
                                  ColumnHeaderStyle="{StaticResource ReportHeaderStyle}"
                                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    <Setter Property="Background" Value="White"/>
                                    <Style.Triggers>
                                        <!-- صفوف متبادلة عند غياب مراحل (تقرير جدولي عادي) -->
                                        <Trigger Property="AlternationIndex" Value="1">
                                            <Setter Property="Background" Value="{StaticResource ErpSurfaceBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource LightBgBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Padding" Value="8,4"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="{StaticResource ErpInkBrush}"/>
                                </Style>
                            </DataGrid.CellStyle>
                        </DataGrid>
                        <TextBlock x:Name="GridHint" IsHitTestVisible="False" Visibility="Visible"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                   FontSize="15" Foreground="{StaticResource ErpMutedBrush}" TextWrapping="Wrap"
                                   MaxWidth="480"
                                   Text="📈 لا نتائج معروضة بعد&#10;اختر تقريراً من المعرض ← حدد الفلاتر ← اضغط «▶ تشغيل التقرير»&#10;أو انقر على أي تقرير نقرتين لتشغيله مباشرة"/>
                    </Grid>
                </Border>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
