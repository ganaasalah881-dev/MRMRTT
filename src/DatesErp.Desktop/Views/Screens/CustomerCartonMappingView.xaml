<UserControl x:Class="DatesErp.Desktop.Views.Screens.CustomerCartonMappingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource NavyBrush}" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="🏷️ كراتين العملاء — ربط ماركة الكرتون بالعميل" FontSize="18" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="كل تاجر/عميل له ماركته الخاصة بالكراتين — عند إنتاج للعميل السلطان يخصم تلقائياً من صنف كراتين السلطان 8كجم بدل العام" 
                           TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}" FontSize="11" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Form -->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource ErpLineBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
            <WrapPanel>
                <StackPanel Margin="0,0,12,8" MinWidth="220">
                    <TextBlock Text="العميل (التاجر) 👤" FontWeight="Bold" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CustomerBox" Width="220" DisplayMemberPath="CustomerName" SelectedValuePath="Id"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,8" MinWidth="200">
                    <TextBlock Text="الصنف التام (اختياري) 🏷️" FontWeight="Bold" Margin="0,0,0,4"/>
                    <ComboBox x:Name="FinishedProductBox" Width="200" DisplayMemberPath="ProductNameAr" SelectedValuePath="Id"/>
                    <TextBlock Text="فارغ = ينطبق على كل أصناف العميل" FontSize="10" Foreground="{StaticResource MutedTextBrush}"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,8" MinWidth="180">
                    <TextBlock Text="العبوة (اختياري) 📦" FontWeight="Bold" Margin="0,0,0,4"/>
                    <ComboBox x:Name="PackagingBox" Width="180" DisplayMemberPath="PackageNameAr" SelectedValuePath="Id"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,8" MinWidth="220">
                    <TextBlock Text="الكرتون العام (يُستبدل) 📦" FontWeight="Bold" Margin="0,0,0,4"/>
                    <ComboBox x:Name="GenericCartonBox" Width="220" DisplayMemberPath="ProductNameAr" SelectedValuePath="Id"/>
                    <TextBlock Text="مثلاً: كراتين فارغ 8كجم عام" FontSize="10" Foreground="{StaticResource MutedTextBrush}"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,8" MinWidth="220">
                    <TextBlock Text="كرتون العميل (ماركة) 🏷️" FontWeight="Bold" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CustomerCartonBox" Width="220" DisplayMemberPath="ProductNameAr" SelectedValuePath="Id"/>
                    <TextBlock Text="مثلاً: كراتين السلطان 8كجم" FontSize="10" Foreground="{StaticResource MutedTextBrush}"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,8" MinWidth="140">
                    <TextBlock Text="اسم الماركة" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBox x:Name="BrandBox" Width="140" Padding="6,4"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,8" MinWidth="80">
                    <TextBlock Text="الأولوية" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBox x:Name="PriorityBox" Width="80" Text="10" Padding="6,4"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,8">
                    <Button Content="💾 حفظ الربط" Style="{StaticResource ErpPrimaryButton}" Click="Save_Click" Margin="0,0,8,0"/>
                    <Button Content="🔄 تحديث" Style="{StaticResource ErpButton}" Click="Refresh_Click"/>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- Grid -->
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource ErpLineBrush}" BorderThickness="1" CornerRadius="8" Margin="0,10,0,0" Padding="8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="📋 روابط كراتين العملاء الحالية — عند إنتاج للعميل يخصم من ماركته تلقائياً" 
                           FontWeight="Bold" Margin="0,0,0,8" Foreground="{StaticResource NavyBrush}"/>
                <DataGrid x:Name="MappingGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="العميل" Binding="{Binding CustomerName}" Width="*"/>
                        <DataGridTextColumn Header="الصنف التام" Binding="{Binding FinishedProductName}" Width="140"/>
                        <DataGridTextColumn Header="العبوة" Binding="{Binding PackagingName}" Width="110"/>
                        <DataGridTextColumn Header="الكرتون العام" Binding="{Binding GenericCartonName}" Width="160"/>
                        <DataGridTextColumn Header="كرتون العميل (ماركة)" Binding="{Binding CustomerCartonName}" Width="160"/>
                        <DataGridTextColumn Header="الماركة" Binding="{Binding BrandName}" Width="110"/>
                        <DataGridTextColumn Header="الأولوية" Binding="{Binding Priority}" Width="70"/>
                        <DataGridTextColumn Header="الحالة" Binding="{Binding IsActive}" Width="70"/>
                        <DataGridTemplateColumn Header="إجراء" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="🗑" ToolTip="حذف/إيقاف" Tag="{Binding Id}" Click="Delete_Click" Padding="4,1" Margin="2"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- Hint -->
        <Border Grid.Row="3" Background="{StaticResource LightBgBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,10,0,0">
            <StackPanel>
                <TextBlock Text="💡 كيف يعمل؟" FontWeight="Bold" Foreground="{StaticResource NavyBrush}"/>
                <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource ErpInkBrush}"
                           Text="مثال: عرّف صنفين مساعدين: 'كراتين فارغ 8كجم عام' و 'كراتين السلطان 8كجم'. ثم في هذه الشاشة اربط: العميل=السلطان، الكرتون العام=فارغ عام، كرتون العميل=السلطان. عند إصدار أمر إنتاج للسلطان (سكري 8كجم 3500 كرتون)، النظام يحسب 3500 كرتون عام ثم يستبدله تلقائياً بـ 3500 كرتون السلطان ويخصم من مخزون WAUX الخاص بالسلطان. كل تاجر له ماركته — لا خلط."/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
