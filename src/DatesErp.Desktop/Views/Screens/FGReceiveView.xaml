<UserControl x:Class="DatesErp.Desktop.Views.Screens.FGReceiveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <!-- أوامر استلام الإنتاج — داخل إدارة المخازن، ومصدره الوحيد أمر تسليم إنتاج محرر -->
    <DockPanel LastChildFill="True">
            <!-- رأس السند -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,8">
                <StackPanel>
                    <Border Style="{StaticResource SecHeader}" Margin="-12,-12,-12,8">
                        <TextBlock Text="🏬 سند استلام إنتاج — وحده يؤثر على أرصدة مخزن التام (كلي/جزئي لكل بند)" FontSize="12" FontWeight="Bold" Foreground="#0A246A"/>
                    </Border>
                    <WrapPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="المصدر:" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="ModeBox" Width="200" SelectionChanged="Mode_Changed"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock x:Name="PickLabel" Text="أمر التسليم المحرر:" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="PickBox" Width="330" SelectionChanged="Pick_Changed"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="رقم السند (تلقائي):" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="DocNoBox" Width="150" IsReadOnly="True" Background="#F0F0F0"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="تاريخ الاستلام:" Style="{StaticResource FieldLabel}"/>
                            <DatePicker x:Name="DateBox" Width="150"/>
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- البنود -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,8">
                <StackPanel>
                    <Border Style="{StaticResource SecHeader}" Margin="-12,-12,-12,8">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="📋 البنود — من أمر التسليم المحرر · عبوة وكراتين المصدر · أدخل المستلم الآن لكل بند" FontSize="12" FontWeight="Bold" Foreground="#0A246A"/>
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <Button Content="⬇ تنزيل البنود" Style="{StaticResource ErpButton}" Click="Download_Click"/>
                                <Button Content="📥 تنفيذ الاستلام" Style="{StaticResource ErpApproveButton}" Click="Receive_Click"/>
                                <Button Content="🔓 إلغاء السند وعكس الأرصدة" Style="{StaticResource ErpDangerButton}" Click="Unapprove_Click"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <DataGrid x:Name="ItemsGrid" Height="132" RowHeight="30" IsReadOnly="False" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="تضمين" Binding="{Binding Included, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                            <DataGridTextColumn Header="الصنف" Binding="{Binding ProductName}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="الدفعة" Binding="{Binding LotCode}" Width="100" IsReadOnly="True"/>
                            <DataGridTextColumn Header="العميل" Binding="{Binding CustomerName}" Width="140" IsReadOnly="True"/>
                            <DataGridTextColumn Header="العبوة" Binding="{Binding PackageName}" Width="120" IsReadOnly="True"/>
                            <DataGridTextColumn Header="عدد الكراتين" Binding="{Binding Packages}" Width="105" IsReadOnly="True"/>
                            <DataGridTextColumn Header="المتبقي" Binding="{Binding Remaining}" Width="90" IsReadOnly="True"/>
                            <DataGridTextColumn Header="كمية السند (كجم)" Binding="{Binding Qty, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                            <DataGridTextColumn Header="المستلم الآن (كجم)" Binding="{Binding ReceiveNow, UpdateSourceTrigger=PropertyChanged}" Width="130"/>
                            <DataGridTextColumn Header="المستلم فعلياً" Binding="{Binding Received}" Width="110" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- سجل السندات -->
            <Border Style="{StaticResource WhiteCard}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="سندات الاستلام (نقر مزدوج للفتح)" FontWeight="Bold" FontSize="12" Foreground="#0A246A" Margin="0,0,0,6"/>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="بحث:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="RecSearchBox" Width="260"/>
                        <Button Content="🔍 بحث" Style="{StaticResource ErpButton}" Click="Search_Click" Margin="6,0,0,0"/>
                    </StackPanel>
                    <DataGrid x:Name="RecordsGrid" AutoGenerateColumns="False" IsReadOnly="True" MouseDoubleClick="Records_DoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الرقم" Binding="{Binding DocNo}" Width="130"/>
                            <DataGridTextColumn Header="سند الاستلام" Binding="{Binding ReceiptNo}" Width="130"/>
                            <DataGridTextColumn Header="الأمر" Binding="{Binding OrderNo}" Width="110"/>
                            <DataGridTextColumn Header="أمر التسليم" Binding="{Binding DeliveryNo}" Width="120"/>
                            <DataGridTextColumn Header="الإجمالي" Binding="{Binding Total}" Width="100"/>
                            <DataGridTextColumn Header="الحالة" Binding="{Binding StatusAr}" Width="100"/>
                            <DataGridTextColumn Header="الاستلام" Binding="{Binding ReceiptAr}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
    </DockPanel>
</UserControl>
