<UserControl x:Class="DatesErp.Desktop.Views.Screens.GenericListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- لوحة البحث والتصفية (المعتمدة) -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,6">
            <StackPanel>
                <Border Style="{StaticResource SecHeader}" Margin="-12,-12,-12,8">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="🔍 محددات البحث والتصفية السريعة" FontSize="12" FontWeight="Bold" Foreground="#0A246A"/>
                        <TextBlock DockPanel.Dock="Left" Text="البحث الفوري في الحقول النشطة" FontSize="11" Foreground="#333"/>
                    </DockPanel>
                </Border>
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="SearchBox" Width="420" TextChanged="Search_Changed"/>
                    <Button Content="🔍 بحث (F9)" Style="{StaticResource ErpPrimaryButton}" Click="SearchBtn_Click"/>
                    <Button Content="📋 عرض الكل" Style="{StaticResource ErpButton}" Click="ShowAll_Click"/>
                    <Button Content="⬇ تصدير CSV" Style="{StaticResource ErpButton}" Click="ExportCsv_Click" ToolTip="تصدير الصفوف المعروضة حالياً (بنفس المرشحات) إلى ملف يفتحه Excel"/>
                    <Button Content="↩ تراجع" Style="{StaticResource ErpButton}" Click="Undo_Click"/>
                    <Button x:Name="ClearBtn" Content="✕ إلغاء" Style="{StaticResource ErpButton}" Click="Clear_Click" Visibility="Collapsed"/>
                </StackPanel>
                <!-- §B89: فلترة احترافية — نطاق الحقل + قيمة من قيم العمود الفعلية + عدّاد حي -->
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="الحقل:" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox x:Name="FieldBox" Width="170" SelectionChanged="FieldBox_Changed" VerticalAlignment="Center"/>
                    <TextBlock Text="القيمة:" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center" Margin="12,0,4,0"/>
                    <ComboBox x:Name="ValueBox" Width="190" SelectionChanged="ValueBox_Changed" VerticalAlignment="Center"/>
                    <TextBlock x:Name="CountText" Text="" FontSize="11.5" FontWeight="Bold" Foreground="#0A246A" VerticalAlignment="Center" Margin="16,0,0,0"/>
                </StackPanel>
                <TextBlock x:Name="StateText" Text="" FontSize="12" Foreground="#555" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <!-- الجدول -->
        <Border Grid.Row="1" Style="{StaticResource WhiteCard}" Padding="0">
            <Grid>
                <DataGrid x:Name="Grid" KeyDown="Grid_KeyDown" MouseDoubleClick="Grid_DoubleClick"/>
                <!-- §44 حالة فراغ موحّدة -->
                <TextBlock x:Name="EmptyHint" Visibility="Collapsed" IsHitTestVisible="False"
                           HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" Foreground="#64748B"
                           Text="لا توجد بيانات للعرض — حدّث القائمة أو عدّل مرشحات البحث"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
