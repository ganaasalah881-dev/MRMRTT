<UserControl x:Class="DatesErp.Desktop.Views.Screens.MyTasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <!-- §7 — لوحة واحدة تبني نفسها من قدرات المستخدم الحالي. لا لوحة «لكل دور». -->
    <DockPanel Margin="8">

        <!-- ═ العدّادات: تتحدث كل 60 ثانية (قرار Q5) ═ -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="🗂 مهامي" FontWeight="Bold" FontSize="15"
                           Foreground="#0A246A" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <TextBlock x:Name="RefreshHint" DockPanel.Dock="Left" FontSize="10.5" Foreground="#94A3B8"
                           VerticalAlignment="Center" Text="يتحدّث تلقائياً"/>
                <WrapPanel x:Name="CountersPanel" Orientation="Horizontal"/>
            </DockPanel>
        </Border>

        <!-- ═ التبويبات ═ -->
        <TabControl x:Name="Tabs" DockPanel.Dock="Top" SelectionChanged="Tab_Changed" BorderThickness="0"
                    Background="Transparent">
            <TabItem x:Name="TabRequired" Header="🔴 مطلوب مني"/>
            <TabItem x:Name="TabInProgress" Header="🟠 قيد العمل"/>
            <TabItem x:Name="TabDoneToday" Header="🟢 أنجزتها اليوم"/>
            <TabItem x:Name="TabUpcoming" Header="📅 الجدول القادم"/>
            <TabItem x:Name="TabAll" Header="🌐 كل المهام (إشراف)"/>
        </TabControl>

        <!-- ═ بطاقات المهام — نقرتان للفتح والتنفيذ ═ -->
        <Border Style="{StaticResource Card}">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="CardsList"/>
                </ScrollViewer>
                <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="13" Foreground="#94A3B8" TextWrapping="Wrap" TextAlignment="Center"
                           Visibility="Collapsed"/>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
