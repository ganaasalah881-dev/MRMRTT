<UserControl x:Class="DatesErp.Desktop.Views.Screens.PlanClosureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <!-- §B79: شاشة «إقفال خطة الإنتاج» — المستوى الإجمالي فوق أوامر الإنتاج.
         لا إقفال قبل اكتمال وإقفال جميع الأوامر المطلوبة؛ والأرقام كلها من البيانات الفعلية. -->
    <DockPanel LastChildFill="True">

        <!-- اختيار الخطة -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,6">
            <WrapPanel>
                <StackPanel Margin="0,0,14,0">
                    <TextBlock Text="خطة الإنتاج *:" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="PlanPickBox" Width="420" SelectionChanged="PlanPick_Changed"/>
                </StackPanel>
                <Button Content="🔄 تحديث" Style="{StaticResource ErpButton}" Click="Refresh_Click" VerticalAlignment="Bottom"/>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Bottom">
                    <TextBlock x:Name="PlanStatusBox" Text="—" FontWeight="Bold" Foreground="#0A246A" Background="#E0F2FE" Padding="8,4"/>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- رأس الخطة -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,6">
            <WrapPanel>
                <StackPanel Margin="0,0,18,0"><TextBlock Text="رقم الخطة:" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="HNumber" FontWeight="Bold" Foreground="#1F2937"/></StackPanel>
                <StackPanel Margin="0,0,18,0"><TextBlock Text="النوع:" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="HType" Foreground="#1F2937"/></StackPanel>
                <StackPanel Margin="0,0,18,0"><TextBlock Text="البداية:" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="HStart" Foreground="#1F2937"/></StackPanel>
                <StackPanel Margin="0,0,18,0"><TextBlock Text="النهاية:" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="HEnd" Foreground="#1F2937"/></StackPanel>
                <StackPanel Margin="0,0,18,0"><TextBlock Text="تاريخ/وقت الإقفال:" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="HClosedAt" Foreground="#14532D"/></StackPanel>
                <StackPanel Margin="0,0,18,0"><TextBlock Text="أقفلها:" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="HClosedBy" Foreground="#14532D"/></StackPanel>
            </WrapPanel>
        </Border>

        <!-- ملخص الخطة -->
        <Border DockPanel.Dock="Top" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" Padding="8,6" Margin="0,0,0,6">
            <WrapPanel>
                <TextBlock x:Name="CTotalOrders" FontWeight="Bold" Foreground="#1F2937" Margin="0,0,14,0"/>
                <TextBlock x:Name="COpen" Foreground="#B45309" Margin="0,0,14,0"/>
                <TextBlock x:Name="CInProgress" Foreground="#B45309" Margin="0,0,14,0"/>
                <TextBlock x:Name="CCompleted" Foreground="#14532D" Margin="0,0,14,0"/>
                <TextBlock x:Name="CClosed" Foreground="#14532D" Margin="0,0,14,0"/>
                <TextBlock x:Name="CCancelled" Foreground="#6B7280" Margin="0,0,14,0"/>
                <TextBlock x:Name="CPlanned" FontWeight="Bold" Foreground="#1F2937" Margin="0,0,14,0"/>
                <TextBlock x:Name="CProduced" FontWeight="Bold" Foreground="#14532D" Margin="0,0,14,0"/>
                <TextBlock x:Name="CClosedQty" FontWeight="Bold" Foreground="#14532D" Margin="0,0,14,0"/>
                <TextBlock x:Name="CRemaining" FontWeight="Bold" Foreground="#B45309" Margin="0,0,14,0"/>
                <TextBlock x:Name="CSettled" FontWeight="Bold" Foreground="#14532D" Margin="0,0,14,0"/>
                <TextBlock x:Name="CUnprocessed" FontWeight="Bold" Foreground="#991B1B" Margin="0,0,14,0"/>
            </WrapPanel>
        </Border>

        <!-- §B83: شارة الجاهزية الصريحة — 🟢 جاهزة / 🔴 غير جاهزة مع السبب -->
        <Border x:Name="ReadinessBanner" DockPanel.Dock="Top" Background="#FEF2F2" BorderBrush="#DC2626" BorderThickness="1.5" CornerRadius="4" Padding="10,6" Margin="0,0,0,6">
            <TextBlock x:Name="ReadinessBox" Text="—" FontSize="13.5" FontWeight="Bold" Foreground="#991B1B" TextWrapping="Wrap"/>
        </Border>

        <!-- الأزرار: الرئيسية الخمسة + الخاصة بالإقفال -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,6">
            <StackPanel>
                <WrapPanel>
                    <Button x:Name="AddPlanBtn" Content="➕ إضافة" Style="{StaticResource ErpButton}" Click="AddPlan_Click" Margin="0,0,6,0" ToolTip="خطة إنتاج جديدة — تُنشأ من شاشة الخطط"/>
                    <Button x:Name="ClosePlanBtn" Content="💾 حفظ وإقفال الخطة" Style="{StaticResource ErpApproveButton}" Click="ClosePlan_Click" Margin="0,0,6,0" ToolTip="الإقفال هو عملية الحفظ في هذه الشاشة — يتحقق من كل الأوامر من قاعدة البيانات قبل التنفيذ"/>
                    <Button x:Name="SearchPlanBtn" Content="🔍 بحث" Style="{StaticResource ErpButton}" Click="SearchPlan_Click" Margin="0,0,6,0" ToolTip="بحث في الخطط برقمها أو عنوانها"/>
                    <Button x:Name="EditPlanBtn" Content="✏️ تعديل" Style="{StaticResource ErpButton}" Click="EditPlan_Click" Margin="0,0,6,0" ToolTip="فتح الخطة في شاشة الخطط للتعديل (غير المقفلة فقط)"/>
                    <Button x:Name="DeletePlanBtn" Content="🗑️ حذف" Style="{StaticResource ErpDangerButton}" Click="DeletePlan_Click" Margin="0,0,6,0" ToolTip="حذف خطة مسودة لم تصدر منها أوامر"/>
                    <Button x:Name="ForceCloseBtn" Content="⚠️ إقفال استثنائي (صلاحية + سبب)" Style="{StaticResource ErpDangerButton}" Click="ForceClose_Click" Visibility="Collapsed" Margin="0,0,6,0"/>
                    <Button x:Name="ReopenBtn" Content="🔓 إعادة فتح الخطة (صلاحية خاصة)" Style="{StaticResource ErpButton}" Click="Reopen_Click" Visibility="Collapsed" Margin="0,0,6,0"/>
                </WrapPanel>
                <TextBlock x:Name="BlockersBox" FontSize="11.5" Foreground="#991B1B" TextWrapping="Wrap" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <!-- التفاصيل: الأوامر + ملخصات العملاء والأصناف -->
        <TabControl>
            <TabItem Header="📋 أوامر الإنتاج التابعة للخطة" FontSize="13">
                <DataGrid x:Name="OrdersGrid" RowHeight="30" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="أمر الإنتاج" Binding="{Binding OrderNumber}" Width="110"/>
                        <DataGridTextColumn Header="العميل" Binding="{Binding CustomerName}" Width="*"/>
                        <DataGridTextColumn Header="الصنف" Binding="{Binding ProductNames}" Width="*"/>
                        <DataGridTextColumn Header="التاريخ" Binding="{Binding Date}" Width="90"/>
                        <DataGridTextColumn Header="الوردية" Binding="{Binding ShiftName}" Width="110"/>
                        <DataGridTextColumn Header="المخطط (كجم)" Binding="{Binding Planned, StringFormat=N0}" Width="100"/>
                        <DataGridTextColumn Header="المنتج (كجم)" Binding="{Binding Produced, StringFormat=N0}" Width="100"/>
                        <DataGridTextColumn Header="المقفل (كجم)" Binding="{Binding Closed, StringFormat=N0}" Width="100"/>
                        <DataGridTextColumn Header="الحالة" Binding="{Binding StateAr}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="👥 ملخص العملاء" FontSize="13">
                <DataGrid x:Name="CustomersGrid" RowHeight="30" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="العميل" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="المخطط" Binding="{Binding Planned, StringFormat=N0}" Width="110"/>
                        <DataGridTextColumn Header="المنتج" Binding="{Binding Produced, StringFormat=N0}" Width="110"/>
                        <DataGridTextColumn Header="المقفل" Binding="{Binding Closed, StringFormat=N0}" Width="110"/>
                        <DataGridTextColumn Header="المتبقي" Binding="{Binding Remaining, StringFormat=N0}" Width="110"/>
                        <DataGridTextColumn Header="الحالة" Binding="{Binding StateAr}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="🏷️ ملخص الأصناف" FontSize="13">
                <DataGrid x:Name="ProductsGrid" RowHeight="30" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الصنف (ProductId من شاشة الأصناف)" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="المخطط" Binding="{Binding Planned, StringFormat=N0}" Width="110"/>
                        <DataGridTextColumn Header="المنتج" Binding="{Binding Produced, StringFormat=N0}" Width="110"/>
                        <DataGridTextColumn Header="المقفل" Binding="{Binding Closed, StringFormat=N0}" Width="110"/>
                        <DataGridTextColumn Header="المتبقي" Binding="{Binding Remaining, StringFormat=N0}" Width="110"/>
                        <DataGridTextColumn Header="الحالة" Binding="{Binding StateAr}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
