<UserControl x:Class="DatesErp.Desktop.Views.Screens.SequencedPlanningView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FlowDirection="RightToLeft">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <StackPanel Margin="12" MinWidth="850">
            <Border Background="{DynamicResource ThemeTableHeaderBrush}" CornerRadius="5" Padding="17,11" Margin="0,0,0,9">
                <StackPanel>
                    <TextBlock Text="خطة الإنتاج · نطاق محدد قبل اختيار الأصناف" Foreground="White" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="كل يوم ووردية بطاقة مستقلة. لا تُفتح التالية قبل اكتمال السابقة. الخطط السابقة محفوظة في مسارها الأصلي."
                               Foreground="{DynamicResource ThemeHeaderForegroundBrush}" FontSize="12" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- Step one: no product/lot selector exists until the server has saved this context. -->
            <Border x:Name="SetupArea" Background="{DynamicResource ThemeAlternateRowBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="13" Margin="0,0,0,9">
                <StackPanel>
                    <TextBlock Text="١ · إعداد الخطة الإلزامي" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ThemeTableHeaderBrush}" Margin="0,0,0,8"/>
                    <WrapPanel>
                        <StackPanel Margin="0,0,15,8"><TextBlock Text="عنوان الخطة *" FontWeight="Bold"/><TextBox x:Name="TitleBox" Width="230" MaxLength="180"/></StackPanel>
                        <StackPanel Margin="0,0,15,8"><TextBlock Text="نوع نطاق العملاء *" FontWeight="Bold"/><ComboBox x:Name="ModeBox" Width="210" SelectionChanged="Mode_Changed"/></StackPanel>
                        <StackPanel Margin="0,0,15,8"><TextBlock Text="من يوم *" FontWeight="Bold"/><DatePicker x:Name="StartBox" Width="150" SelectedDateChanged="Start_Changed"/></StackPanel>
                        <StackPanel Margin="0,0,15,8"><TextBlock Text="إلى يوم (اليوم نفسه لخطة يومية) *" FontWeight="Bold"/><DatePicker x:Name="EndBox" Width="170"/></StackPanel>
                        <StackPanel Margin="0,0,15,8"><TextBlock Text="خط الإنتاج *" FontWeight="Bold"/><ComboBox x:Name="LineBox" Width="205" DisplayMemberPath="LineNameAr"/></StackPanel>
                    </WrapPanel>
                    <WrapPanel Margin="0,5,0,4">
                        <StackPanel Margin="0,0,22,0">
                            <TextBlock Text="العملاء المختارون * (انقر مع Ctrl لاختيار عدة عملاء)" FontWeight="Bold"/>
                            <ListBox x:Name="CustomersBox" SelectionMode="Multiple" DisplayMemberPath="CustomerName" Width="320" Height="123"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="الورديات * (واحدة أو اثنتان؛ ترتيبها حسب وقت البدء)" FontWeight="Bold"/>
                            <ListBox x:Name="ShiftsBox" SelectionMode="Multiple" DisplayMemberPath="ShiftNameAr" Width="310" Height="123"/>
                        </StackPanel>
                    </WrapPanel>
                    <TextBlock x:Name="SetupHelp" Foreground="{DynamicResource ThemeWarningBrush}" FontSize="12" Text="لا تُفترض وصفة لسحب الخام: تُعتمد صراحة من مسؤول الأصناف قبل إكمال أي بند." Margin="0,3,0,8"/>
                    <Button x:Name="CreateBtn" Content="حفظ الإعداد وبدء اليوم والوردية الأولى" Click="Create_Click" Style="{StaticResource ErpPrimaryButton}" Width="290" HorizontalAlignment="Right"/>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource ThemeCardBackgroundBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Padding="10" Margin="0,0,0,9">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="خطط الإنتاج المحفوظة · اختر سطرًا لفتحه (بما فيها الخطط التاريخية)" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource ThemeTableHeaderBrush}"/>
                        <Button DockPanel.Dock="Left" Content="تحديث القائمة" Click="RefreshPlans_Click" Style="{StaticResource ErpButton}"/>
                    </DockPanel>
                    <DataGrid x:Name="PlansGrid" Height="125" AutoGenerateColumns="False" IsReadOnly="True" MouseDoubleClick="OpenPlan_Click" Margin="0,6,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="رقم المستند" Binding="{Binding DocumentNumber}" Width="150"/>
                            <DataGridTextColumn Header="العنوان" Binding="{Binding Title}" Width="*"/>
                            <DataGridTextColumn Header="الفترة" Binding="{Binding Period}" Width="190"/>
                            <DataGridTextColumn Header="نوع المسار" Binding="{Binding Route}" Width="120"/>
                            <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="115"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <Border x:Name="CardArea" Visibility="Collapsed" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Background="White" CornerRadius="5" Padding="13">
                <StackPanel>
                    <TextBlock x:Name="PlanHeader" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource ThemeTableHeaderBrush}"/>
                    <TextBlock x:Name="ScopeSummary" Foreground="{DynamicResource ThemeTextBrush}" Margin="0,4,0,9" TextWrapping="Wrap"/>
                    <TextBlock Text="٢ · بطاقات أيام وورديات الخطة (بالترتيب؛ انقر بطاقة مكتملة لمراجعتها)" FontWeight="Bold" Foreground="{DynamicResource ThemeTableHeaderBrush}"/>
                    <ListBox x:Name="CardsList" DisplayMemberPath="Label" Height="83" SelectionChanged="Card_Changed" Margin="0,5,0,9"/>
                    <Border Background="{DynamicResource ThemeAlternateRowBrush}" CornerRadius="3" Padding="8" Margin="0,0,0,8">
                        <TextBlock x:Name="CardHeader" Foreground="{DynamicResource ThemeTableHeaderBrush}" FontSize="13" FontWeight="Bold"/>
                    </Border>
                    <TextBlock Text="الدفعات والأصناف المؤهلة للنطاق · غياب الوصفة/الطاقة أو الخام المفرج عنه يظهر سبب المنع" FontWeight="Bold"/>
                    <DataGrid x:Name="LotsGrid" Height="165" IsReadOnly="True" AutoGenerateColumns="False" Margin="0,5,0,5">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="العميل" Binding="{Binding CustomerName}" Width="130"/>
                            <DataGridTextColumn Header="الدفعة" Binding="{Binding LotCode}" Width="115"/>
                            <DataGridTextColumn Header="الصنف التام" Binding="{Binding ProductName}" Width="155"/>
                            <DataGridTextColumn Header="العبوة" Binding="{Binding PackagingName}" Width="110"/>
                            <DataGridTextColumn Header="وزن الكرتون" Binding="{Binding CartonWeightKg}" Width="95"/>
                            <DataGridTextColumn Header="القوالب" Binding="{Binding MoldsCount}" Width="65"/>
                            <DataGridTextColumn Header="وزن القالب" Binding="{Binding MoldWeightKg}" Width="80"/>
                            <DataGridTextColumn Header="خام/كرتون" Binding="{Binding RawKgPerCarton}" Width="90"/>
                            <DataGridTextColumn Header="حد الوقت (استرشادي)" Binding="{Binding TimeMaximumCartons}" Width="115"/>
                            <DataGridTextColumn Header="حد الخط (استرشادي)" Binding="{Binding LineMaximumCartons}" Width="115"/>
                            <DataGridTextColumn Header="الحد النهائي" Binding="{Binding MaximumCartons}" Width="85"/>
                            <DataGridTextColumn Header="السبب / القيد" Binding="{Binding Reason}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <WrapPanel Margin="0,0,0,8">
                        <Button x:Name="AddBtn" Content="إضافة الاختيار إلى هذه الوردية" Click="Add_Click" Style="{StaticResource ErpButton}" Margin="0,0,8,0"/>
                        <Button x:Name="RuleBtn" Content="اعتماد سحب الخام للعبوة (مسؤول الأصناف)" Click="Rule_Click" Style="{StaticResource ErpButton}" Margin="0,0,8,0"/>
                        <Button x:Name="FairBtn" Content="اقتراح توزيع حسب العملاء والخام" Click="Fair_Click" Style="{StaticResource ErpButton}"/>
                    </WrapPanel>
                    <TextBlock Text="بنود هذه البطاقة فقط · عدّل الكراتين ثم احسب الحد؛ لا يمكن تغيير اليوم/الوردية/العميل خارج الإعداد" FontWeight="Bold"/>
                    <DataGrid x:Name="RowsGrid" Height="178" AutoGenerateColumns="False" CanUserAddRows="False" CellEditEnding="Rows_EditEnding" Margin="0,5,0,5">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="العميل" Binding="{Binding Customer}" Width="130" IsReadOnly="True"/>
                            <DataGridTextColumn Header="الدفعة" Binding="{Binding Lot}" Width="120" IsReadOnly="True"/>
                            <DataGridTextColumn Header="الصنف" Binding="{Binding Product}" Width="145" IsReadOnly="True"/>
                            <DataGridTextColumn Header="العبوة" Binding="{Binding Pack}" Width="100" IsReadOnly="True"/>
                            <DataGridTextColumn Header="كجم/كرتون" Binding="{Binding Weight}" Width="90" IsReadOnly="True"/>
                            <DataGridTextColumn Header="كجم خام/كرتون" Binding="{Binding RawPerCarton}" Width="98" IsReadOnly="True"/>
                            <DataGridTextColumn Header="الكراتين المطلوبة *" Binding="{Binding CartonsText, UpdateSourceTrigger=PropertyChanged}" Width="130"/>
                            <DataGridTextColumn Header="الحد بعد بقية البنود" Binding="{Binding MaxText}" Width="120" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="CapacityHint" Text="اختر صنفًا ودفعة، ثم أدخل الكمية واضغط حساب الحد." Foreground="{DynamicResource ThemeWarningBrush}" TextWrapping="Wrap" Margin="0,0,0,7"/>
                    <WrapPanel>
                        <Button x:Name="QuoteBtn" Content="حساب الحد المسموح" Click="Quote_Click" Style="{StaticResource ErpButton}" Margin="0,0,7,7"/>
                        <Button x:Name="RemoveBtn" Content="إزالة البند المختار" Click="Remove_Click" Style="{StaticResource ErpButton}" Margin="0,0,7,7"/>
                        <Button x:Name="SaveBtn" Content="حفظ بطاقة الوردية" Click="Save_Click" Style="{StaticResource ErpPrimaryButton}" Margin="0,0,7,7"/>
                        <Button x:Name="CompleteBtn" Content="إكمال الوردية والانتقال للتالية" Click="Complete_Click" Style="{StaticResource ErpPrimaryButton}" Margin="0,0,7,7"/>
                        <Button x:Name="NoProductionBtn" Content="اعتماد عدم تشغيل الوردية" Click="NoProduction_Click" Style="{StaticResource ErpButton}" Margin="0,0,7,7"/>
                        <Button x:Name="SubmitBtn" Content="إرسال الخطة المكتملة للاعتماد" Click="Submit_Click" Style="{StaticResource ErpButton}" Margin="0,0,7,7"/>
                        <Button x:Name="ApproveBtn" Content="اعتماد الخطة" Click="Approve_Click" Style="{StaticResource ErpButton}" Margin="0,0,7,7"/>
                        <Button x:Name="ReturnBtn" Content="إرجاع للتعديل مع سبب" Click="Return_Click" Style="{StaticResource ErpButton}" Margin="0,0,7,7"/>
                        <Button x:Name="UnapproveBtn" Content="فك الاعتماد قبل الأوامر فقط" Click="Unapprove_Click" Style="{StaticResource ErpButton}" Margin="0,0,7,7"/>
                        <Button x:Name="CancelSetupBtn" Content="إلغاء الإعداد قبل البنود" Click="CancelSetup_Click" Style="{StaticResource ErpButton}" Margin="0,0,7,7"/>
                        <Button Content="سجل تعديلات الخطة" Click="History_Click" Style="{StaticResource ErpButton}" Margin="0,0,7,7"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
