<UserControl x:Class="DatesErp.Desktop.Views.Screens.AuxiliarySetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <DockPanel Margin="12">
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="🧩 تهيئة الأصناف المساعدة" FontSize="22" FontWeight="Bold" Foreground="{StaticResource DarkTitleBrush}"/>
                <TextBlock Text="تعريف الأصناف المساعدة مرة واحدة وربطها ببطاقة الصنف الرئيسية — لا نكرر التعريف إذا كان موجوداً في بطاقة الأصناف." 
                           TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" FontSize="13" Margin="0,4,0,0"/>
                <TextBlock Text="الصنف المساعد: المجموعة (أصناف مساعدة) + وحدة المخزون الأساسية + وزن الوحدة + طريقة الصرف (بالوحدة/بالكيلو/حسب كمية الإنتاج) + هل يحتاج صرف عند إصدار أمر الإنتاج؟ + حالة فعال/غير فعال"
                           TextWrapping="Wrap" Foreground="{StaticResource LightMutedBrush}" FontSize="11" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="إضافة / تعديل تهيئة صنف مساعد" FontWeight="Bold" FontSize="13" Margin="0,0,0,6"/>
                <WrapPanel>
                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="الصنف المساعد *:" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="ProductBox" Width="260" DisplayMemberPath="ProductNameAr" SelectedValuePath="Id"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="المجموعة/التصنيف:" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="GroupBox" Width="160" DisplayMemberPath="GroupNameAr" SelectedValuePath="GroupCode" IsEditable="True" Text="أصناف مساعدة"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="وحدة المخزون الأساسية *:" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="UnitBox" Width="120" IsEditable="True" Text="وحدة"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="وزن الوحدة (كجم):" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="WeightBox" Width="100" Text="0"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="طريقة الصرف *:" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="MethodBox" Width="160" SelectedIndex="0">
                            <ComboBoxItem Content="بالوحدة" Tag="ByUnit"/>
                            <ComboBoxItem Content="بالكيلو" Tag="ByKilo"/>
                            <ComboBoxItem Content="حسب كمية الإنتاج" Tag="PerProduction"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Margin="0,0,14,0" VerticalAlignment="Bottom">
                        <CheckBox x:Name="NeedsIssueCheck" Content="يحتاج صرف عند إصدار أمر الإنتاج" IsChecked="True" FontWeight="Bold"/>
                        <CheckBox x:Name="ActiveCheck" Content="فعال" IsChecked="True" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button Content="💾 حفظ التهيئة" Style="{StaticResource ErpPrimaryButton}" Click="Save_Click" VerticalAlignment="Bottom" Margin="0,0,8,0"/>
                    <Button Content="🔄 تحديث" Style="{StaticResource ErpButton}" Click="Refresh_Click" VerticalAlignment="Bottom"/>
                </WrapPanel>
                <TextBlock x:Name="HintLabel" TextWrapping="Wrap" Foreground="{StaticResource PrimaryBrush}" FontSize="11" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="قائمة الأصناف المساعدة المهيأة" FontWeight="Bold" FontSize="13" Margin="0,0,0,6"/>
                <DataGrid x:Name="SetupGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeight="32" MinHeight="260">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الكود" Binding="{Binding ProductCode}" Width="100"/>
                        <DataGridTextColumn Header="الصنف المساعد" Binding="{Binding ProductName}" Width="*"/>
                        <DataGridTextColumn Header="المجموعة" Binding="{Binding GroupCode}" Width="120"/>
                        <DataGridTextColumn Header="الوحدة" Binding="{Binding BaseUnit}" Width="80"/>
                        <DataGridTextColumn Header="وزن الوحدة" Binding="{Binding UnitWeightKg}" Width="90"/>
                        <DataGridTextColumn Header="طريقة الصرف" Binding="{Binding DispensingMethodAr}" Width="130"/>
                        <DataGridTextColumn Header="يحتاج صرف؟" Binding="{Binding NeedsIssueOnOrder}" Width="100"/>
                        <DataGridTextColumn Header="الحالة" Binding="{Binding IsActive}" Width="80"/>
                        <DataGridTextColumn Header="مُهيأ؟" Binding="{Binding IsConfigured}" Width="60"/>
                        <DataGridTemplateColumn Header="تعديل" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="✏️" Style="{StaticResource ErpButton}" Click="Edit_Click" Tag="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
