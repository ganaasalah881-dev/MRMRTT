<UserControl x:Class="DatesErp.Desktop.Views.Screens.CartonView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <TabControl>
        <TabItem Header="📦 الرصيد والحركات">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="170"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Style="{StaticResource WhiteCard}" Margin="0,0,0,8">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="أرصدة الكرتون الفارغ حسب المخزن (كرتون)" FontWeight="Bold" Foreground="#0A246A" Margin="0,0,0,4"/>
                        <DataGrid x:Name="BalGrid" AutoGenerateColumns="False" RowHeight="28" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="المخزن" Binding="{Binding Warehouse}" Width="*"/>
                                <DataGridTextColumn Header="الصنف" Binding="{Binding Product}" Width="*"/>
                                <DataGridTextColumn Header="الرصيد (كرتون)" Binding="{Binding Cartons}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource WhiteCard}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="📜 دفتر حركات الكرتون (تولّد/بيع/عدّ)" FontWeight="Bold" Foreground="#0A246A" VerticalAlignment="Center"/>
                            <Button Content="تحديث" Style="{StaticResource ErpButton}" Click="Refresh_Click" Margin="14,0,0,0"/>
                        </StackPanel>
                        <DataGrid x:Name="MovGrid" AutoGenerateColumns="False" RowHeight="26" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="التاريخ" Binding="{Binding Date}" Width="100"/>
                                <DataGridTextColumn Header="الحركة" Binding="{Binding Txn}" Width="90"/>
                                <DataGridTextColumn Header="المستند المرجعي" Binding="{Binding Ref}" Width="140"/>
                                <DataGridTextColumn Header="المخزن" Binding="{Binding Warehouse}" Width="*"/>
                                <DataGridTextColumn Header="وارد" Binding="{Binding Inb}" Width="70"/>
                                <DataGridTextColumn Header="صادر/تسوية" Binding="{Binding Outb}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>
        </TabItem>

        
        <TabItem Header="🔢 عدّ فعلي — إدخال مباشر من الجدول">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <WrapPanel Margin="0,0,0,8">
                        <StackPanel Margin="0,0,14,0">
                            <TextBlock Text="مخزن العدّ *:" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CountWhBox" Width="220" DisplayMemberPath="WarehouseNameAr" SelectedValuePath="Id"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,14,0">
                            <TextBlock Text="تاريخ العدّ:" Style="{StaticResource FieldLabel}"/>
                            <DatePicker x:Name="CountDateBox" Width="140"/>
                        </StackPanel>
                        <Button Content="➕ صف جديد" Style="{StaticResource ErpPrimaryButton}" Click="AddCountRowInline_Click" VerticalAlignment="Bottom" ToolTip="إضافة صف جديد — جميع أنواع الكرتون معروضة فوراً"/>
                        <Button Content="⎘ تكرار الصف" Style="{StaticResource ErpButton}" Click="DuplicateCountRow_Click" VerticalAlignment="Bottom" Margin="6,0,0,0" ToolTip="تكرار الصف (7-ج)"/>
                        <Button Content="💾 تسجيل سند العدّ وتقييد الفروق" Style="{StaticResource ErpApproveButton}" Click="SaveCount_Click" VerticalAlignment="Bottom" Margin="10,0,0,0"/>
                    </WrapPanel>
                    <TextBlock Text="التعليمات: اضغط على (الصنف) داخل صف جديد → جميع أنواع الكرتون (004) معروضة فوراً → اختيار ينزل مع الرصيد الدفتري. أدخل العدّ الفعلي في نفس الصف — الفرق يُحسب تلقائياً. خلية بها خطأ تتحول أحمر (7-ز)." TextWrapping="Wrap" FontSize="11" Margin="0,0,0,6"/>
                    <DataGrid x:Name="CountGrid" Height="260" MinHeight="160" RowHeight="34" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="White"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsInvalid}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource InvalidRowBrush}"/>
                                        <Setter Property="ToolTip" Value="{Binding ValidationError}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="الصنف (004) *" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Product}" Click="CountProduct_Click" Tag="{Binding}" Style="{StaticResource ErpButton}" ToolTip="جميع أنواع الكرتون معروضة فوراً"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="الدفتري" Binding="{Binding Book}" Width="90" IsReadOnly="True"/>
                            <DataGridTextColumn Header="الفعلي *" Binding="{Binding Counted, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                            <DataGridTextColumn Header="الفرق" Binding="{Binding Diff}" Width="90" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="حذف" Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="✕" Style="{StaticResource ErpDangerButton}" Click="RemoveCountRow_Click" Tag="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="CountHint" Text="الفرق (الفعلي − الدفتري) يُقيَّد حركة تسوية آلياً ويُوثق في السجل." Foreground="#555" FontSize="11" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </TabItem>

        <TabItem Header="💰 بيع الكرتون — إدخال مباشر">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <WrapPanel Margin="0,0,0,8">
                        <StackPanel Margin="0,0,14,0">
                            <TextBlock Text="العميل المشتري (اختياري):" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="SaleCustBox" Width="220" DisplayMemberPath="CustomerName" SelectedValuePath="Id"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,14,0">
                            <TextBlock Text="مخزن الصرف *:" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="SaleWhBox" Width="220" DisplayMemberPath="WarehouseNameAr" SelectedValuePath="Id"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,14,0">
                            <TextBlock Text="سعر الكرتون:" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="PriceBox" Width="100" Text="0"/>
                        </StackPanel>
                        <Button Content="➕ صف جديد" Style="{StaticResource ErpPrimaryButton}" Click="AddSaleRowInline_Click" VerticalAlignment="Bottom" ToolTip="جميع أنواع الكرتون معروضة فوراً"/>
                        <Button Content="⎘ تكرار الصف" Style="{StaticResource ErpButton}" Click="DuplicateSaleRow_Click" VerticalAlignment="Bottom" Margin="6,0,0,0"/>
                        <Button Content="💾 حفظ سند البيع" Style="{StaticResource ErpApproveButton}" Click="SaveSale_Click" VerticalAlignment="Bottom" Margin="10,0,0,0"/>
                        <Button Content="🖨 طباعة السند" Style="{StaticResource ErpButton}" Click="PrintSale_Click" VerticalAlignment="Bottom" Margin="10,0,0,0"/>
                    </WrapPanel>
                    <TextBlock Text="اضغط على (الصنف) داخل صف جديد → جميع أنواع الكرتون معروضة فوراً → أدخل الكراتين في نفس الصف — الإجمالي يُحسب تلقائياً." TextWrapping="Wrap" FontSize="11" Margin="0,0,0,6"/>
                    <DataGrid x:Name="SaleGrid" Height="260" MinHeight="160" RowHeight="34" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="White"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsInvalid}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource InvalidRowBrush}"/>
                                        <Setter Property="ToolTip" Value="{Binding ValidationError}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="الصنف (004) *" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Product}" Click="SaleProduct_Click" Tag="{Binding}" Style="{StaticResource ErpButton}" ToolTip="جميع أنواع الكرتون معروضة فوراً"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="كراتين البيع *" Binding="{Binding Cartons, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                            <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount}" Width="110" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="حذف" Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="✕" Style="{StaticResource ErpDangerButton}" Click="RemoveSaleRow_Click" Tag="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="SaleTotal" Text="الإجمالي: 0" FontWeight="Bold" Foreground="#14532D" FontSize="13" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </TabItem>

    </TabControl>
</UserControl>