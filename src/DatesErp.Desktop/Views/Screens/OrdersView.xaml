<UserControl x:Class="DatesErp.Desktop.Views.Screens.OrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <!-- §v1.50.36 — شاشة واحدة: الخطط المجدولة + مستند الأمر أسفلها بلا تبديل واجهات. -->
    <!-- المحتوى قد يتجاوز ارتفاع النافذة عند فتح مستند الأمر؛ التمرير هنا يحافظ على
         ظهور شريط الأوامر والجدول ويتيح الوصول إلى كل بيانات المستند أسفل الجدول. -->
    <ScrollViewer x:Name="OrdersScroll" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
        <DockPanel x:Name="ListArea" LastChildFill="True" Margin="12">
        <!-- رأس الشاشة: شريط داكن مطابق للهوية المرئية المعتمدة في نموذج التصميم. -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Background="{DynamicResource ThemeTitleBarBrush}" BorderBrush="{DynamicResource ThemeTitleBarBrush}" Padding="16,11" Margin="0,0,0,6">
            <StackPanel>
                <DockPanel>
                    <TextBlock Text="📝 أوامر الإنتاج" FontSize="22" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="MRPMPS1007" DockPanel.Dock="Left" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource ThemeHeaderForegroundBrush}" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock x:Name="DayLabel" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource ThemeSecondaryBrush}" Margin="0,6,0,2"/>
                <TextBlock x:Name="DayHint" TextWrapping="Wrap" Foreground="{DynamicResource ThemeHeaderForegroundBrush}" FontSize="13"/>
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Top" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" Padding="8,5" Margin="0,0,0,6">
            <WrapPanel VerticalAlignment="Center">
                <Border Background="#FFF7E0" BorderBrush="#E9CE7E" BorderThickness="1" CornerRadius="11" Padding="9,3" Margin="0,0,8,0">
                    <TextBlock x:Name="DayChip" Text="📅 اليوم: —" FontSize="11.5" FontWeight="Bold" Foreground="#8A6A00"/>
                </Border>
                <Border Background="#EDF3EE" BorderBrush="#CADCCF" BorderThickness="1" CornerRadius="11" Padding="9,3" Margin="0,0,8,0">
                    <TextBlock x:Name="ItemsChip" Text="📦 البنود المجدولة: 0" FontSize="11.5" FontWeight="Bold" Foreground="#14532D"/>
                </Border>
                <Border Background="#F3EEFB" BorderBrush="#D6C8EF" BorderThickness="1" CornerRadius="11" Padding="9,3" Margin="0,0,8,0">
                    <TextBlock x:Name="IssuedChip" Text="🗂 أوامر صادرة: 0" FontSize="11.5" FontWeight="Bold" Foreground="#6D28D9"/>
                </Border>
                <Border Background="#E8F1FA" BorderBrush="#B8CFE8" BorderThickness="1" CornerRadius="11" Padding="9,3" Margin="0,0,8,0">
                    <TextBlock x:Name="PendingChip" Text="⏳ بانتظار الإصدار: 0" FontSize="11.5" FontWeight="Bold" Foreground="#0A246A"/>
                </Border>
                <Border Background="#FBE9E7" BorderBrush="#E8B8AE" BorderThickness="1" CornerRadius="11" Padding="9,3">
                    <TextBlock x:Name="DayClosedChip" Text="🔒 أُقفل يومه: 0" FontSize="11.5" FontWeight="Bold" Foreground="#8A3B2E"/>
                </Border>
            </WrapPanel>
        </Border>
        <Border DockPanel.Dock="Top" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" Padding="8,4" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚖ إجماليات الخطط المجدولة:" FontWeight="Bold" Foreground="#14532D" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock x:Name="TotCartonsBox" Text="الكراتين المجدولة: 0" FontWeight="Bold" Foreground="{DynamicResource ThemeTextBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock x:Name="TotQtyBox" Text="الوزن المجدول: 0 كجم" FontWeight="Bold" Foreground="#14532D" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock x:Name="TotCustsBox" Text="عملاء: 0" FontWeight="Bold" Foreground="#7C3AED" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock x:Name="TotLinesBox" Text="خطوط: 0" FontWeight="Bold" Foreground="{DynamicResource ThemeTextBrush}" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Background="#F8F4E8" BorderBrush="#D8CDAE" Padding="10,8" Margin="0,0,0,6">
            <WrapPanel>
                <!-- أزرار الجدول فقط؛ الأفعال العامة (إضافة/تعديل/حفظ/بحث/حذف/طباعة) في شريط واحد بالأعلى. -->
                <Button x:Name="IssueTodayBtn" Content="📤 إصدار أوامر اليوم من الخطة" Style="{StaticResource ErpApproveButton}" Click="IssueToday_Click" Margin="0,0,8,4" IsEnabled="False" ToolTip="هذا الزر لخطط تاريخ العمل الحالي فقط؛ للخطط السابقة أو القادمة حدّد الصف ثم استخدم إصدار المحدد"/>
                <Button x:Name="IssueSelectedBtn" Content="✅ إصدار المحدد فقط" Style="{StaticResource ErpApproveButton}" Click="IssueSelected_Click" Margin="0,0,8,4" ToolTip="اختر صفاً أو ضع علامة ✓؛ سيصدر كامل مجموعته بتاريخها الأصلي وبكميات الخطة"/>
                <Button x:Name="ApproveSelectedBtn" Content="🔒 اعتماد الأمر المحدد" Style="{StaticResource ErpApproveButton}" Click="ApproveSelected_Click" Margin="0,0,8,4" ToolTip="اعتماد المسودة بعد فحص الخطة والطاقة والعبوة والدفعات — يتطلب صلاحية production/Approve"/>
                <Button x:Name="SelectAllBtn" Content="☑ تحديد الكل" Style="{StaticResource ErpButton}" Click="SelectAll_Click" Margin="0,0,8,4"/>
            </WrapPanel>
        </Border>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="1.1*" MinHeight="160"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1.4*" MinHeight="180"/>
            </Grid.RowDefinitions>
            <DataGrid x:Name="TodayGrid" xmlns:sys="clr-namespace:System;assembly=mscorlib" Grid.Row="0" AutoGenerateColumns="False" IsReadOnly="False"
                      CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single"
                      SelectionUnit="FullRow" RowHeight="32" ColumnHeaderHeight="36" FontSize="13.5"
                      AlternatingRowBackground="{DynamicResource ThemeAlternateRowBrush}" Background="{DynamicResource ThemeTableBackgroundBrush}" RowBackground="{DynamicResource ThemeTableBackgroundBrush}"
                      GridLinesVisibility="All" HorizontalGridLinesBrush="{DynamicResource ThemeGridLineBrush}" VerticalGridLinesBrush="{DynamicResource ThemeGridLineBrush}"
                      HeadersVisibility="Column" BorderBrush="{DynamicResource ThemeGridLineBrush}"
                      SelectionChanged="TodayGrid_SelectionChanged" MouseDoubleClick="TodayGrid_DoubleClick">
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="6,3"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#10283E"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="7,5"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="BorderBrush" Value="#284C68"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="White"/>
                        <!-- لا يوجد إدخال كميات في هذه الشبكة؛ الكميات تُقرأ من الخطة المعتمدة فقط. -->
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="✓" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="40"/>
                    <DataGridTextColumn Header="التاريخ المجدول" Binding="{Binding ScheduledDate, Mode=OneWay}" Width="115" IsReadOnly="True"/>
                    <DataGridTextColumn Header="العميل 👤" Binding="{Binding CustomerName, Mode=OneWay}" Width="1.2*" MinWidth="130" IsReadOnly="True"/>
                    <DataGridTextColumn Header="ماذا سننتج؟ 🏷️" Binding="{Binding ProductName, Mode=OneWay}" Width="1.6*" MinWidth="160" IsReadOnly="True"/>
                    <DataGridTextColumn Header="الكراتين المخططة" Binding="{Binding PlannedCartons, Mode=OneWay, StringFormat=N0}" Width="105" IsReadOnly="True"/>
                    <DataGridTextColumn Header="الوزن (كجم) ⚖️" Binding="{Binding PlannedKg, Mode=OneWay, StringFormat=N1}" Width="105" IsReadOnly="True"/>
                    <DataGridTextColumn Header="الوحدة 📏" Binding="{Binding Unit, Mode=OneWay}" Width="70" IsReadOnly="True"/>
                    <DataGridTextColumn Header="الوردية ⏰" Binding="{Binding ShiftName, Mode=OneWay}" Width="110" IsReadOnly="True"/>
                    <DataGridTextColumn Header="الخط 🏭" Binding="{Binding LineName, Mode=OneWay}" Width="90" IsReadOnly="True"/>
                    <DataGridTextColumn Header="الخطة 📋" Binding="{Binding PlanNumber, Mode=OneWay}" Width="105" IsReadOnly="True"/>
                    <DataGridTextColumn Header="الأمر 📄" Binding="{Binding OrderNumber, Mode=OneWay}" Width="105" IsReadOnly="True"/>
                    <DataGridTextColumn Header="حالة التنفيذ" Binding="{Binding Status, Mode=OneWay}" Width="1.2*" MinWidth="150" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
            <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" Background="#CBD5E1"/>
            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,4,0,0">
                <Grid>
                    <TextBlock x:Name="DetailsHint" Text="اختر بنداً صادراً من الجدول أعلاه لعرض مستند الأمر هنا — دون مغادرة الشاشة."
                               Foreground="{DynamicResource ThemeSecondaryTextBrush}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextWrapping="Wrap" Margin="16"/>
                    <ContentControl x:Name="DetailsHost"/>
                </Grid>
            </Border>
        </Grid>
        </DockPanel>
    </ScrollViewer>
</UserControl>
