<Window x:Class="DatesErp.Desktop.Views.ShipmentPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="اختيار إيصال سابق للنسخ" Height="420" Width="640" FlowDirection="RightToLeft" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Text="📋 إيصالات سابقة — اختر إيصالاً لنسخ بنوده إلى السند الحالي" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,8,0,0">
            <Button Content="✅ نسخ" Style="{StaticResource ErpPrimaryButton}" Click="Ok_Click" Width="90"/>
            <Button Content="إلغاء" Style="{StaticResource ErpButton}" Click="Cancel_Click" Width="80" Margin="8,0,0,0"/>
        </StackPanel>
        <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="رقم الإيصال" Binding="{Binding DocumentNumber}" Width="140"/>
                <DataGridTextColumn Header="العميل" Binding="{Binding CustomerId}" Width="80"/>
                <DataGridTextColumn Header="التاريخ" Binding="{Binding ReceivedDate}" Width="110"/>
                <DataGridTextColumn Header="الوزن" Binding="{Binding TotalWeightKg}" Width="100"/>
                <DataGridTextColumn Header="بنود" Binding="{Binding Items.Count}" Width="60"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
